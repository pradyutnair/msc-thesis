#!/bin/bash
#SBATCH --job-name=m6_noise
#SBATCH --partition=gpu_a100
#SBATCH --time=01:00:00
#SBATCH --ntasks=1
#SBATCH --cpus-per-task=16
#SBATCH --gpus=1
#SBATCH --mem=96G
#SBATCH --output=/projects/prjs1800/msc-thesis/02-arag-multi-agent/jobs/output/%j_m6_noise_experiment.log

set -euo pipefail
module purge; module load 2025; module load Anaconda3/2025.06-1; module load CUDA/12.8.0

cd /projects/prjs1800/msc-thesis/02-arag-multi-agent
source /projects/prjs1800/venvs/arag-venv/bin/activate
export PYTHONNOUSERSITE=1
export HF_HOME="/projects/prjs1800/.cache/huggingface"
export HF_HUB_CACHE="$HF_HOME"; export TRANSFORMERS_CACHE="$HF_HOME"
export TOKENIZERS_PARALLELISM=false
export PYTHONPATH="/projects/prjs1800/msc-thesis/04-sage-autonomous/src:${PYTHONPATH:-}"

PORT=$((8000 + RANDOM % 1000))
export ARAG_API_KEY="dummy"
export ARAG_BASE_URL="http://127.0.0.1:${PORT}/v1"
export ARAG_MODEL="Qwen3-8B"

RUN_CLEAN="results/noise_clean/hotpotqa"
RUN_NOISY="results/noise_noisy/hotpotqa"
mkdir -p "$RUN_CLEAN" "$RUN_NOISY" jobs/output

cleanup() { [[ -n "${VLLM_PID:-}" ]] && kill -0 "$VLLM_PID" 2>/dev/null && kill "$VLLM_PID" || true; }
trap cleanup EXIT TERM INT

python -m vllm.entrypoints.openai.api_server \
  --model "Qwen/Qwen3-8B" --served-model-name "Qwen3-8B" --host 127.0.0.1 --port "$PORT" \
  --dtype auto --max-model-len 32768 --gpu-memory-utilization 0.90 \
  --max-num-seqs 256 \
  --enable-prefix-caching \
  --enable-auto-tool-choice --tool-call-parser hermes \
  --trust-remote-code --generation-config vllm &
VLLM_PID=$!

for i in $(seq 1 300); do
  if ! kill -0 "$VLLM_PID" 2>/dev/null; then wait "$VLLM_PID" || true; exit 1; fi
  STATUS="$(python -c "
import json, urllib.request
try:
    d=json.load(urllib.request.urlopen('http://127.0.0.1:${PORT}/v1/models', timeout=2))
    print('ok' if any('Qwen3-8B' in m.get('id','') for m in d.get('data',[])) else 'wait')
except Exception:
    print('wait')
")"
  if [[ "$STATUS" == "ok" ]]; then echo "vLLM ready after ${i} checks"; break; fi
  sleep 3
done

echo ""
echo "=== M6 on CLEAN corpus (100q) ==="
rm -f "$RUN_CLEAN/predictions.jsonl"
python -u scripts/m6_runner.py \
  --config configs/m6_blackboard.yaml \
  --dataset hotpotqa \
  --output "$RUN_CLEAN" \
  --limit 100 \
  --workers 50

python -u /projects/prjs1800/msc-thesis/04-sage-autonomous/scripts/eval_offline.py "$RUN_CLEAN/predictions.jsonl"

echo ""
echo "=== M6 on NOISY corpus (100q) ==="
rm -f "$RUN_NOISY/predictions.jsonl"
python -u scripts/m6_runner.py \
  --config configs/m6_blackboard.yaml \
  --dataset hotpotqa \
  --output "$RUN_NOISY" \
  --limit 100 \
  --workers 50 \
  --chunks-file data/hotpotqa/chunks_noisy.json

python -u /projects/prjs1800/msc-thesis/04-sage-autonomous/scripts/eval_offline.py "$RUN_NOISY/predictions.jsonl"

echo ""
echo "=== DONE ==="
