#!/bin/bash
#SBATCH --job-name=m6v21_1000q
#SBATCH --partition=gpu_h100
#SBATCH --time=01:30:00
#SBATCH --ntasks=1
#SBATCH --cpus-per-task=16
#SBATCH --gpus=1
#SBATCH --mem=96G
#SBATCH --output=/projects/prjs1800/msc-thesis/02-arag-multi-agent/jobs/output/%j_m6v21_1000q_%a.log
#SBATCH --array=0-2

set -euo pipefail
module purge; module load 2025; module load Anaconda3/2025.06-1; module load CUDA/12.8.0

cd /projects/prjs1800/msc-thesis/02-arag-multi-agent
source /projects/prjs1800/venvs/arag-venv/bin/activate
export PYTHONNOUSERSITE=1
export HF_HOME="/projects/prjs1800/.cache/huggingface"
export HF_HUB_CACHE="$HF_HOME"; export TRANSFORMERS_CACHE="$HF_HOME"
export TOKENIZERS_PARALLELISM=false
export PYTHONPATH="/projects/prjs1800/msc-thesis/04-sage-autonomous/src:${PYTHONPATH:-}"

DATASETS=(hotpotqa 2wiki musique)
DATASET="${DATASETS[$SLURM_ARRAY_TASK_ID]}"
RUN_OUT="results/m6v21_1000/$DATASET"
mkdir -p "$RUN_OUT" jobs/output

PORT=$((8000 + RANDOM % 1000))
export ARAG_API_KEY="dummy"
export ARAG_BASE_URL="http://127.0.0.1:${PORT}/v1"
export ARAG_MODEL="Qwen3-8B"

cleanup() { [[ -n "${VLLM_PID:-}" ]] && kill -0 "$VLLM_PID" 2>/dev/null && kill "$VLLM_PID" || true; }
trap cleanup EXIT TERM INT

# ── Phase 1: Generation with Qwen3-8B ──

echo "Starting vLLM (Qwen3-8B) on port $PORT..."
python -m vllm.entrypoints.openai.api_server \
  --model "Qwen/Qwen3-8B" --served-model-name "Qwen3-8B" --host 127.0.0.1 --port "$PORT" \
  --dtype auto --max-model-len 32768 --gpu-memory-utilization 0.90 \
  --max-num-seqs 256 \
  --enable-prefix-caching \
  --enable-auto-tool-choice --tool-call-parser hermes \
  --trust-remote-code --generation-config vllm &
VLLM_PID=$!

for i in $(seq 1 300); do
  if ! kill -0 "$VLLM_PID" 2>/dev/null; then wait "$VLLM_PID" || true; exit 1; fi
  STATUS="$(python -c "
import json, urllib.request
try:
    d=json.load(urllib.request.urlopen('http://127.0.0.1:${PORT}/v1/models', timeout=2))
    print('ok' if any('Qwen3-8B' in m.get('id','') for m in d.get('data',[])) else 'wait')
except Exception:
    print('wait')
")"
  if [[ "$STATUS" == "ok" ]]; then echo "vLLM ready after ${i} checks"; break; fi
  sleep 3
done

echo ""
echo "=== M6v21 1000q Generation: $DATASET ==="
python -u scripts/m6_runner.py \
  --config configs/m6_blackboard.yaml \
  --dataset "$DATASET" \
  --output "$RUN_OUT" \
  --limit 1000 \
  --workers 50

echo ""
echo "=== Offline Eval ==="
python -u /projects/prjs1800/msc-thesis/04-sage-autonomous/scripts/eval_offline.py "$RUN_OUT/predictions.jsonl"

# ── Phase 2: Kill Qwen, start DeepSeek judge ──

echo ""
echo "Killing Qwen3-8B, starting DeepSeek-R1 judge..."
kill "$VLLM_PID" 2>/dev/null; wait "$VLLM_PID" 2>/dev/null || true
sleep 5

JUDGE_PORT=$((8000 + RANDOM % 1000))

python -m vllm.entrypoints.openai.api_server \
  --model "deepseek-ai/DeepSeek-R1-Distill-Qwen-32B" \
  --served-model-name "DeepSeek-R1-Distill-Qwen-32B" \
  --host 127.0.0.1 --port "$JUDGE_PORT" \
  --dtype auto --max-model-len 32768 --gpu-memory-utilization 0.92 \
  --max-num-seqs 64 \
  --enable-prefix-caching \
  --trust-remote-code &
VLLM_PID=$!

for i in $(seq 1 300); do
  if ! kill -0 "$VLLM_PID" 2>/dev/null; then wait "$VLLM_PID" || true; exit 1; fi
  STATUS="$(python -c "
import json, urllib.request
try:
    d=json.load(urllib.request.urlopen('http://127.0.0.1:${JUDGE_PORT}/v1/models', timeout=2))
    print('ok' if any('DeepSeek' in m.get('id','') for m in d.get('data',[])) else 'wait')
except Exception:
    print('wait')
")"
  if [[ "$STATUS" == "ok" ]]; then echo "Judge vLLM ready after ${i} checks"; break; fi
  sleep 3
done

export ARAG_BASE_URL="http://127.0.0.1:${JUDGE_PORT}/v1"
export ARAG_MODEL="DeepSeek-R1-Distill-Qwen-32B"

echo ""
echo "=== Strict LLM Judge: $DATASET ==="
python -u scripts/eval_strict.py \
  --predictions "$RUN_OUT/predictions.jsonl" \
  --workers 40 \
  --output "$RUN_OUT"

echo ""
echo "=== DONE: $DATASET ==="
echo "Results: $RUN_OUT/"
cat "$RUN_OUT/offline_eval_summary.json"
echo ""
cat "$RUN_OUT/predictions_eval_summary.json"
