#!/bin/bash
#SBATCH --job-name=reagent1k
#SBATCH --partition=gpu_h100
#SBATCH --time=04:00:00
#SBATCH --ntasks=1
#SBATCH --cpus-per-task=8
#SBATCH --gpus=1
#SBATCH --mem=64G
#SBATCH --output=/projects/prjs1800/msc-thesis/02-arag-multi-agent/jobs/output/%j_reagent_qwen3_1000q_%a.log
#SBATCH --array=0-14

set -euo pipefail
module purge
module load 2025
module load Anaconda3/2025.06-1
module load CUDA/12.8.0

REAGENT_ROOT="/projects/prjs1800/external/ReAgent"
REAGENT_VENV="/projects/prjs1800/venvs/ReAgent-venv"
ARAG_PYTHON="/projects/prjs1800/venvs/arag-venv/bin/python"
RESULTS_ROOT="/projects/prjs1800/msc-thesis/02-arag-multi-agent/results/reagent_qwen3_1000"
LOG_ROOT="/projects/prjs1800/msc-thesis/02-arag-multi-agent/jobs/output"

cd "$REAGENT_ROOT"
source "$REAGENT_VENV/bin/activate"
export PYTHONNOUSERSITE=1
export HF_HOME="/projects/prjs1800/.cache/huggingface"
export HF_HUB_CACHE="$HF_HOME"
export TRANSFORMERS_CACHE="$HF_HOME"
export TOKENIZERS_PARALLELISM=false
export NO_PROXY="127.0.0.1,localhost"
export no_proxy="127.0.0.1,localhost"

mkdir -p "$LOG_ROOT" "$RESULTS_ROOT" config

DATASETS=(hotpotqa 2wiki musique)
SHARDS=5
PER_SHARD=200

DATASET_IDX=$((SLURM_ARRAY_TASK_ID / SHARDS))
SHARD_IDX=$((SLURM_ARRAY_TASK_ID % SHARDS))
DATASET="${DATASETS[$DATASET_IDX]}"
OFFSET=$((SHARD_IDX * PER_SHARD))

RUN_OUT="$RESULTS_ROOT/$DATASET/shard_$SHARD_IDX"
mkdir -p "$RUN_OUT"

PORT=$((8000 + RANDOM % 1000))
cat > config/env.yaml <<EOF
services:
  openai:
    api_key: "dummy"
    base_url: "http://127.0.0.1:${PORT}/v1"
  qwen:
    api_key: "dummy"
    base_url: "http://127.0.0.1:${PORT}/v1"
  deepseek:
    api_key: "dummy"
    base_url: "http://127.0.0.1:${PORT}/v1"
  claude:
    api_key: "dummy"
    base_url: "http://127.0.0.1:${PORT}/v1"
EOF

cleanup() {
  if [[ -n "${VLLM_PID:-}" ]] && kill -0 "$VLLM_PID" 2>/dev/null; then
    kill "$VLLM_PID" || true
  fi
}
trap cleanup EXIT TERM INT

echo "Starting Qwen3-8B vLLM for $DATASET shard $SHARD_IDX on port $PORT"
"$ARAG_PYTHON" -m vllm.entrypoints.openai.api_server \
  --model "Qwen/Qwen3-8B" \
  --served-model-name "qwen3-8b" \
  --host 127.0.0.1 \
  --port "$PORT" \
  --dtype auto \
  --max-model-len 16384 \
  --gpu-memory-utilization 0.92 \
  --max-num-seqs 32 \
  --enable-prefix-caching \
  --trust-remote-code \
  --generation-config vllm &
VLLM_PID=$!

for i in $(seq 1 240); do
  if ! kill -0 "$VLLM_PID" 2>/dev/null; then
    wait "$VLLM_PID" || true
    exit 1
  fi
  STATUS="$(python -c "
import json, urllib.request
try:
    data = json.load(urllib.request.urlopen('http://127.0.0.1:${PORT}/v1/models', timeout=2))
    print('ok' if any('qwen3-8b' in m.get('id', '').lower() for m in data.get('data', [])) else 'wait')
except Exception:
    print('wait')
")"
  if [[ "$STATUS" == "ok" ]]; then
    echo "vLLM ready after $i checks"
    break
  fi
  sleep 2
done

python -u batch_eval_arag.py \
  --dataset "$DATASET" \
  --output "$RUN_OUT" \
  --offset "$OFFSET" \
  --limit "$PER_SHARD" \
  --top-k 8 \
  --max-context-chars 12000 \
  --max-chunk-chars 1800 \
  --model qwen3-8b \
  --temperature 0.0

python -u /projects/prjs1800/msc-thesis/04-sage-autonomous/scripts/eval_offline.py "$RUN_OUT/predictions.jsonl"

echo "Done: $DATASET shard $SHARD_IDX"
