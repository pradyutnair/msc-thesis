#!/bin/bash
#SBATCH --job-name=eval_m6v12b
#SBATCH --partition=gpu_h100
#SBATCH --time=04:00:00
#SBATCH --ntasks=1
#SBATCH --cpus-per-task=8
#SBATCH --gpus=1
#SBATCH --mem=96G
#SBATCH --output=/projects/prjs1800/msc-thesis/02-arag-multi-agent/jobs/output/%j_eval_m6v12b_pilot100_%a.log
#SBATCH --array=0-2

set -euo pipefail
module purge; module load 2025; module load Anaconda3/2025.06-1; module load CUDA/12.8.0

cd /projects/prjs1800/msc-thesis/02-arag-multi-agent
source /projects/prjs1800/venvs/arag-venv/bin/activate
export PYTHONNOUSERSITE=1
export HF_HOME="/projects/prjs1800/.cache/huggingface"
export HF_HUB_CACHE="$HF_HOME"; export TRANSFORMERS_CACHE="$HF_HOME"
export TOKENIZERS_PARALLELISM=false

MODEL_ID="deepseek-ai/DeepSeek-R1-Distill-Qwen-32B"
SERVED_NAME="DeepSeek-R1-32B"
HOST="127.0.0.1"
PORT="8000"

export ARAG_API_KEY="dummy"
export ARAG_BASE_URL="http://$HOST:$PORT/v1"
export ARAG_MODEL="$SERVED_NAME"

DATASETS=(hotpotqa 2wiki musique)
DATASET="${DATASETS[$SLURM_ARRAY_TASK_ID]}"

PRED_FILE="results/m6v12b_pilot100/$DATASET/predictions.jsonl"

cleanup() { [[ -n "${VLLM_PID:-}" ]] && kill -0 "$VLLM_PID" 2>/dev/null && kill "$VLLM_PID" || true; }
trap cleanup EXIT TERM INT

echo "Starting vLLM server with DeepSeek-R1-Distill-Qwen-32B (judge) on H100..."
python -m vllm.entrypoints.openai.api_server \
  --model "$MODEL_ID" --served-model-name "$SERVED_NAME" --host "$HOST" --port "$PORT" \
  --dtype auto --max-model-len 32768 --gpu-memory-utilization 0.90 \
  --trust-remote-code &
VLLM_PID=$!

for i in $(seq 1 300); do
  if ! kill -0 "$VLLM_PID" 2>/dev/null; then wait "$VLLM_PID" || true; exit 1; fi
  STATUS="$(python -c "
import json, urllib.request
try:
    d=json.load(urllib.request.urlopen('http://$HOST:$PORT/v1/models', timeout=2))
    print('ok' if any('$SERVED_NAME' in m.get('id','') for m in d.get('data',[])) else 'wait')
except Exception:
    print('wait')
")"
  if [[ "$STATUS" == "ok" ]]; then echo "vLLM ready"; break; fi
  sleep 5
done

echo "=== Evaluating M6v12b pilot100 $DATASET with DeepSeek-R1 judge ==="
python -u /projects/prjs1800/external/arag/scripts/eval.py \
  --predictions "$PRED_FILE" \
  --workers 10

echo "Eval $DATASET complete"
