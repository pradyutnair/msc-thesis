#!/bin/bash
#SBATCH --job-name=s12_1kM
#SBATCH --partition=gpu_h100
#SBATCH --time=08:00:00
#SBATCH --ntasks=1
#SBATCH --cpus-per-task=16
#SBATCH --gpus=1
#SBATCH --mem=96G
#SBATCH --output=/projects/prjs1800/msc-thesis/02-arag-multi-agent/results/logs/%j_sage_v12_1000_musique_resumable.out

set -euo pipefail
module purge
module load 2025
module load Anaconda3/2025.06-1
module load CUDA/12.8.0

cd /projects/prjs1800/msc-thesis/02-arag-multi-agent
source /projects/prjs1800/venvs/arag-venv/bin/activate

export PYTHONNOUSERSITE=1
export HF_HOME="/projects/prjs1800/.cache/huggingface"
export HF_HUB_CACHE="$HF_HOME"
export TRANSFORMERS_CACHE="$HF_HOME"
export TOKENIZERS_PARALLELISM=false

export ARAG_API_KEY="dummy"
export ARAG_BASE_URL="http://127.0.0.1:8000/v1"
export ARAG_MODEL="Qwen3-30B-A3B"

MODEL_ID="Qwen/Qwen3-30B-A3B"
SERVED_NAME="Qwen3-30B-A3B"
RUN_OUT="results/sage_v12_1000/musique"
TARGET=1000
mkdir -p "$RUN_OUT" results/logs

cleanup() {
  [[ -n "${VLLM_PID:-}" ]] && kill -0 "$VLLM_PID" 2>/dev/null && kill "$VLLM_PID" || true
}
trap cleanup EXIT TERM INT

echo "=== SAGE v12 MuSiQue resumable from-scratch run ==="
echo "Output: $RUN_OUT"
echo "Start: $(date)"

vllm serve "$MODEL_ID" \
  --served-model-name "$SERVED_NAME" \
  --host 127.0.0.1 --port 8000 \
  --dtype auto \
  --max-model-len 32768 \
  --gpu-memory-utilization 0.94 \
  --max-num-seqs 96 \
  --enable-prefix-caching \
  --enable-auto-tool-choice \
  --tool-call-parser hermes \
  --trust-remote-code \
  --generation-config vllm &
VLLM_PID=$!

for i in $(seq 1 360); do
  if ! kill -0 "$VLLM_PID" 2>/dev/null; then
    wait "$VLLM_PID" || true
    exit 1
  fi
  if curl -fsS http://127.0.0.1:8000/v1/models 2>/dev/null | grep -q "$SERVED_NAME"; then
    echo "vLLM ready after ~$((i*5))s"
    break
  fi
  sleep 5
done

START_TS=$(date +%s)
MAX_RUN_SEC=$((7*60*60 + 40*60))

while true; do
  PRED="$RUN_OUT/predictions.jsonl"
  DONE=0
  if [[ -f "$PRED" ]]; then
    DONE=$(wc -l < "$PRED")
  fi

  echo "Progress: $DONE/$TARGET"
  if (( DONE >= TARGET )); then
    echo "Reached target count."
    break
  fi

  NOW=$(date +%s)
  ELAPSED=$((NOW - START_TS))
  if (( ELAPSED >= MAX_RUN_SEC )); then
    echo "Stopping before walltime. Re-submit same job to continue."
    break
  fi

  PYTHONPATH=src python -u scripts/multi_agent_runner.py \
    --config configs/sage_v12_musique.yaml \
    --questions data/musique/questions.json \
    --output "$RUN_OUT" \
    --limit 1000 \
    --concurrent 24

done

if [[ -f "$RUN_OUT/predictions.jsonl" ]]; then
  CUR=$(wc -l < "$RUN_OUT/predictions.jsonl")
  echo "Final count: $CUR/$TARGET"
fi

echo "=== Done === $(date)"
