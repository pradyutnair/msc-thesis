#!/bin/bash
#SBATCH --job-name=eval_e2_dsr1
#SBATCH --partition=gpu_h100
#SBATCH --time=04:00:00
#SBATCH --ntasks=1
#SBATCH --cpus-per-task=8
#SBATCH --gpus=1
#SBATCH --mem=96G
#SBATCH --output=/projects/prjs1800/msc-thesis/02-arag-multi-agent/jobs/output/%j_eval_e2_deepseek_%a.log
#SBATCH --array=0-2

set -euo pipefail
module purge; module load 2025; module load Anaconda3/2025.06-1; module load CUDA/12.8.0

cd /projects/prjs1800/external/arag
source /projects/prjs1800/venvs/arag-venv/bin/activate
export PYTHONNOUSERSITE=1
export HF_HOME="/projects/prjs1800/.cache/huggingface"
export HF_HUB_CACHE="$HF_HOME"; export TRANSFORMERS_CACHE="$HF_HOME"
export TOKENIZERS_PARALLELISM=false

MODEL_ID="deepseek-ai/DeepSeek-R1-Distill-Qwen-32B"
SERVED_NAME="DeepSeek-R1-32B"
HOST="127.0.0.1"
PORT="8000"

export ARAG_API_KEY="dummy"
export ARAG_BASE_URL="http://$HOST:$PORT/v1"
export ARAG_MODEL="$SERVED_NAME"

DATASETS_SHORT=(hotpotqa 2wiki musique)
DATASETS_FULL=(hotpotqa 2wikimultihop musique)
DS_SHORT="${DATASETS_SHORT[$SLURM_ARRAY_TASK_ID]}"
DS_FULL="${DATASETS_FULL[$SLURM_ARRAY_TASK_ID]}"

# E2 predictions — first 100 questions only
E2_PRED="/projects/prjs1800/msc-thesis/01-arag-reproduction/results/qwen3-8b-vllm/$DS_FULL/predictions.jsonl"

# Extract first 100 to a temp file
TEMP_PRED="/tmp/e2_first100_${DS_SHORT}.jsonl"
head -100 "$E2_PRED" > "$TEMP_PRED"
echo "Extracted first 100 predictions from $E2_PRED"

cleanup() { [[ -n "${VLLM_PID:-}" ]] && kill -0 "$VLLM_PID" 2>/dev/null && kill "$VLLM_PID" || true; }
trap cleanup EXIT TERM INT

echo "Starting vLLM server with DeepSeek-R1-Distill-Qwen-32B (judge) on H100..."
python -m vllm.entrypoints.openai.api_server \
  --model "$MODEL_ID" --served-model-name "$SERVED_NAME" --host "$HOST" --port "$PORT" \
  --dtype auto --max-model-len 32768 --gpu-memory-utilization 0.90 \
  --trust-remote-code &
VLLM_PID=$!

for i in $(seq 1 300); do
  if ! kill -0 "$VLLM_PID" 2>/dev/null; then wait "$VLLM_PID" || true; exit 1; fi
  STATUS="$(python -c "
import json, urllib.request
try:
    d=json.load(urllib.request.urlopen('http://$HOST:$PORT/v1/models', timeout=2))
    print('ok' if any('$SERVED_NAME' in m.get('id','') for m in d.get('data',[])) else 'wait')
except Exception:
    print('wait')
")"
  if [[ "$STATUS" == "ok" ]]; then echo "vLLM ready"; break; fi
  sleep 5
done

echo "=== Evaluating E2 (qwen3-8b-vllm) $DS_SHORT first 100q with DeepSeek-R1 judge ==="
uv run --active python /projects/prjs1800/external/arag/scripts/eval.py \
  --predictions "$TEMP_PRED" \
  --workers 10

# Copy results back
OUTDIR="/projects/prjs1800/msc-thesis/02-arag-multi-agent/results/e2_deepseek_eval/$DS_SHORT"
mkdir -p "$OUTDIR"
cp "$TEMP_PRED" "$OUTDIR/predictions.jsonl"
cp "$(dirname $TEMP_PRED)/$(basename $TEMP_PRED .jsonl)_eval_summary.json" "$OUTDIR/" 2>/dev/null || true

echo "Eval E2 $DS_SHORT complete"
