#!/bin/bash
#SBATCH --job-name=m6v23s
#SBATCH --partition=gpu_h100
#SBATCH --time=00:30:00
#SBATCH --ntasks=1
#SBATCH --cpus-per-task=16
#SBATCH --gpus=1
#SBATCH --mem=96G
#SBATCH --output=jobs/output/%j_m6v23_smoke10.log
#SBATCH --array=0

set -euo pipefail
module purge; module load 2025; module load Anaconda3/2025.06-1; module load CUDA/12.8.0

cd /projects/prjs1800/msc-thesis/02-arag-multi-agent
source /projects/prjs1800/venvs/arag-venv/bin/activate
export PYTHONNOUSERSITE=1
export HF_HOME="/projects/prjs1800/.cache/huggingface"
export HF_HUB_CACHE="$HF_HOME"; export TRANSFORMERS_CACHE="$HF_HOME"
export TOKENIZERS_PARALLELISM=false

DATASET="musique"
RUN_OUT="results/m6v23_smoke10/$DATASET"
rm -rf "$RUN_OUT"
mkdir -p "$RUN_OUT" jobs/output

PORT=$((8000 + RANDOM % 1000))
export ARAG_API_KEY="dummy"
export ARAG_BASE_URL="http://127.0.0.1:${PORT}/v1"
export ARAG_MODEL="Qwen3-8B"

cleanup() { [[ -n "${VLLM_PID:-}" ]] && kill -0 "$VLLM_PID" 2>/dev/null && kill "$VLLM_PID" || true; }
trap cleanup EXIT TERM INT

python -m vllm.entrypoints.openai.api_server \
  --model "Qwen/Qwen3-8B" --served-model-name "Qwen3-8B" --host 127.0.0.1 --port "$PORT" \
  --dtype auto --max-model-len 32768 --gpu-memory-utilization 0.92 \
  --max-num-seqs 512 --enable-prefix-caching \
  --enable-auto-tool-choice --tool-call-parser hermes \
  --chat-template /projects/prjs1800/scripts/qwen3_no_think_template.jinja \
  --trust-remote-code &
VLLM_PID=$!

for i in $(seq 1 120); do
  if ! kill -0 "$VLLM_PID" 2>/dev/null; then wait "$VLLM_PID" || true; exit 1; fi
  curl -s http://127.0.0.1:${PORT}/v1/models >/dev/null 2>&1 && break
  sleep 3
done
echo "vLLM ready on port $PORT"

# IMPORTANT: We need the OLD answer_utils.py for v23 baseline
# Since we modified answer_utils.py, v23 will also use the new normalization
# This is actually fine -- it lets us isolate prompt improvements vs normalization

python -u scripts/m6_runner.py \
  --config configs/m6v23.yaml \
  --dataset musique \
  --output "$RUN_OUT" \
  --limit 10 \
  --workers 10

echo "=== M6v23 smoke10 musique DONE ==="

python3 -c "
import json, re, string, unicodedata
def norm(s):
    s = str(s).lower().strip()
    s = unicodedata.normalize('NFKD', s)
    s = re.sub(r'\b(a|an|the)\b', ' ', s)
    s = s.translate(str.maketrans('', '', string.punctuation))
    s = re.sub(r'\s+', ' ', s).strip()
    return s
def f1(p,g):
    pt,gt=set(norm(p).split()),set(norm(g).split())
    if not pt or not gt: return 0.0
    c=pt&gt
    if not c: return 0.0
    pr=len(c)/len(pt);rc=len(c)/len(gt)
    return 2*pr*rc/(pr+rc)
preds=[json.loads(l) for l in open('results/m6v23_smoke10/musique/predictions.jsonl')]
n=len(preds)
em=sum(1 for p in preds if norm(str(p.get('pred_answer','') or ''))==norm(str(p.get('gold_answer',''))))/n*100
f1_avg=sum(f1(str(p.get('pred_answer','') or ''),str(p.get('gold_answer',''))) for p in preds)/n*100
print(f'\\n=== M6v23 MuSiQue smoke10: EM={em:.1f}% F1={f1_avg:.1f}% (n={n}) ===')
for p in preds:
    pred=str(p.get('pred_answer','') or '')[:60]
    gold=str(p.get('gold_answer',''))[:60]
    match='✓' if norm(pred)==norm(gold) else '✗'
    print(f'  {match} PRED: {pred:40s} GOLD: {gold}')
"
