#!/bin/bash
#SBATCH --job-name=s7bf_1kM
#SBATCH --partition=gpu_h100
#SBATCH --time=02:00:00
#SBATCH --ntasks=1
#SBATCH --cpus-per-task=16
#SBATCH --gpus=1
#SBATCH --mem=96G
#SBATCH --output=/projects/prjs1800/msc-thesis/02-arag-multi-agent/results/logs/%j_sage_v7b_fast_1000_musique.out

set -euo pipefail
module purge; module load 2025; module load Anaconda3/2025.06-1; module load CUDA/12.8.0

cd /projects/prjs1800/msc-thesis/02-arag-multi-agent
source /projects/prjs1800/venvs/arag-venv/bin/activate
export PYTHONNOUSERSITE=1
export HF_HOME="/projects/prjs1800/.cache/huggingface"
export HF_HUB_CACHE="$HF_HOME"; export TRANSFORMERS_CACHE="$HF_HOME"
export TOKENIZERS_PARALLELISM=false
export ARAG_API_KEY="dummy"
export ARAG_BASE_URL="http://127.0.0.1:8000/v1"
export ARAG_MODEL="Qwen3-30B-A3B"

MODEL_ID="Qwen/Qwen3-30B-A3B"; SERVED_NAME="Qwen3-30B-A3B"
RUN_OUT="results/sage_v7b_fast_1000/musique"

# Clean slate — runner skips existing predictions
rm -rf "$RUN_OUT"
mkdir -p "$RUN_OUT" results/logs

cleanup() { [[ -n "${VLLM_PID:-}" ]] && kill -0 "$VLLM_PID" 2>/dev/null && kill "$VLLM_PID" || true; }
trap cleanup EXIT TERM INT

echo "=== SAGE v7b-fast: Full 1000q MuSiQue ==="
echo "Optimizations: verification_rounds=1, thinking=disabled, concurrent=100"
echo "vLLM: max-num-batched-tokens=32768, max-num-seqs=128"
echo "Start: $(date)"
T_START=$SECONDS

# Start vLLM with optimized batching
echo ""
echo "--- Starting vLLM server ---"
vllm serve "$MODEL_ID" --served-model-name "$SERVED_NAME" --host 127.0.0.1 --port 8000 \
    --dtype auto --max-model-len 32768 --gpu-memory-utilization 0.92 \
    --max-num-seqs 128 --max-num-batched-tokens 32768 \
    --enable-prefix-caching --enable-auto-tool-choice --tool-call-parser hermes \
    --trust-remote-code --generation-config vllm &
VLLM_PID=$!

for i in $(seq 1 360); do
    if ! kill -0 "$VLLM_PID" 2>/dev/null; then echo "vLLM died!"; wait "$VLLM_PID" || true; exit 1; fi
    resp="$(curl -fsS http://127.0.0.1:8000/v1/models 2>/dev/null || true)"
    if [[ -n "$resp" ]] && echo "$resp" | python -c "import json,sys; d=json.load(sys.stdin); print(any(m.get('id')=='$SERVED_NAME' for m in d.get('data',[])))" | grep -q True; then
        echo "vLLM ready after ~$((i*5))s"
        break
    fi
    sleep 5
done
T_VLLM_READY=$SECONDS

# Phase 1: Generation (1000 questions)
echo ""
echo "--- Phase 1: SAGE v7b-fast Generation (1000 questions, concurrent=100) ---"
T_GEN_START=$SECONDS
PYTHONPATH=src python -u scripts/multi_agent_runner.py \
    --config configs/sage_v7b_fast_musique.yaml \
    --questions data/musique/questions.json \
    --output "$RUN_OUT" \
    --limit 1000 --concurrent 100
T_GEN_END=$SECONDS

PRED_COUNT=$(wc -l < "$RUN_OUT/predictions.jsonl")
echo ""
echo "Predictions: $PRED_COUNT lines"

# Phase 2: Offline eval
echo ""
echo "--- Phase 2: Offline eval ---"
PYTHONPATH=src python -u scripts/eval_offline.py "$RUN_OUT/predictions.jsonl"

# Phase 3: LLM Judge eval (vLLM still running)
echo ""
echo "--- Phase 3: LLM Judge eval ---"
PYTHONPATH=src python -u scripts/eval.py \
    --predictions "$RUN_OUT/predictions.jsonl"
T_EVAL_END=$SECONDS

# Phase 4: Summary comparison
echo ""
echo "=== RESULTS COMPARISON ==="
echo "Reference baselines:"
echo "  E4 MuSiQue:          37.6%  (376/1000)"
echo "  SAGE v7 original:    36.79% (351/954)"
echo ""

python3 -u << 'PYEOF'
import json
preds = [json.loads(l) for l in open("results/sage_v7b_fast_1000/musique/predictions.jsonl")]
total = len(preds)
answered = sum(1 for p in preds if p["pred_answer"].strip())
empty = total - answered

# LLM judge accuracy
has_llm = any("llm_accuracy" in p for p in preds)
if has_llm:
    correct = sum(1 for p in preds if p.get("llm_accuracy") == 1.0)
    pct = correct / max(answered, 1) * 100
    print(f"SAGE v7b-fast MuSiQue:")
    print(f"  Total: {total}, Answered: {answered}, Empty: {empty}")
    print(f"  LLM Correct: {correct}/{answered} = {pct:.2f}%")
    delta_e4 = pct - 37.6
    delta_v7 = pct - 36.79
    print(f"  vs E4 (37.6%): {'BEATS' if delta_e4 > 0 else 'BELOW'} by {abs(delta_e4):.2f}pp")
    print(f"  vs SAGE v7 (36.79%): {'BEATS' if delta_v7 > 0 else 'BELOW'} by {abs(delta_v7):.2f}pp")
else:
    print(f"SAGE v7b-fast MuSiQue (no LLM judge yet):")
    print(f"  Total: {total}, Answered: {answered}, Empty: {empty}")
    print("  (Run eval job for LLM judge scores)")

# Timing stats
import statistics
wall_times = [p.get("wall_clock_seconds", 0) for p in preds if p.get("wall_clock_seconds")]
token_counts = [p.get("total_tokens", 0) for p in preds if p.get("total_tokens")]
if wall_times:
    print(f"\nTiming per question:")
    print(f"  Mean: {statistics.mean(wall_times):.1f}s, Median: {statistics.median(wall_times):.1f}s")
    print(f"  P90: {sorted(wall_times)[int(0.9*len(wall_times))]:.1f}s, Max: {max(wall_times):.1f}s")
if token_counts:
    print(f"Tokens per question:")
    print(f"  Mean: {statistics.mean(token_counts):.0f}, Median: {statistics.median(token_counts):.0f}")
PYEOF

# Timing summary
echo ""
echo "=== TIMING ==="
echo "vLLM startup:   $((T_VLLM_READY - T_START))s"
echo "Generation:     $((T_GEN_END - T_GEN_START))s for $PRED_COUNT questions"
GEN_SECS=$((T_GEN_END - T_GEN_START))
if [ "$GEN_SECS" -gt 0 ]; then
    QRATE=$(python3 -c "print(f'{$PRED_COUNT/$GEN_SECS*3600:.0f}')")
    echo "Throughput:     $QRATE Q/hr"
    GEN_MIN=$(python3 -c "print(f'{$GEN_SECS/60:.1f}')")
    echo "Generation:     ${GEN_MIN} min"
fi
echo "Eval:           $((T_EVAL_END - T_GEN_END))s"
echo "Total wall:     $((SECONDS - T_START))s ($((($SECONDS - $T_START)/60)) min)"
echo ""
echo "=== Done === $(date)"
