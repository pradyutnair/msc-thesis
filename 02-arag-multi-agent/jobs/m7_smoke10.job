#!/bin/bash
#SBATCH --job-name=m7_smoke10
#SBATCH --partition=gpu_h100
#SBATCH --time=00:20:00
#SBATCH --ntasks=1
#SBATCH --cpus-per-task=16
#SBATCH --gpus=1
#SBATCH --mem=96G
#SBATCH --output=/projects/prjs1800/msc-thesis/02-arag-multi-agent/jobs/output/%j_m7_smoke10.log

set -euo pipefail
module purge
module load 2025
module load Anaconda3/2025.06-1
module load CUDA/12.8.0

cd /projects/prjs1800/msc-thesis/02-arag-multi-agent
source /projects/prjs1800/venvs/arag-venv/bin/activate
export PYTHONNOUSERSITE=1
export HF_HOME="/projects/prjs1800/.cache/huggingface"
export HF_HUB_CACHE="$HF_HOME"
export TRANSFORMERS_CACHE="$HF_HOME"
export TOKENIZERS_PARALLELISM=false
export ARAG_API_KEY="dummy"
export ARAG_BASE_URL="http://127.0.0.1:8000/v1"
export ARAG_MODEL="Qwen3-8B"

MODEL_ID="Qwen/Qwen3-8B"
SERVED_NAME="Qwen3-8B"
RUN_OUT="results/m7_smoke_v1/hotpotqa"
QUESTIONS_FILE="data/hotpotqa/m7_smoke_10.json"
mkdir -p "$RUN_OUT" jobs/output

cleanup() {
  if [[ -n "${VLLM_PID:-}" ]] && kill -0 "$VLLM_PID" 2>/dev/null; then
    kill "$VLLM_PID" || true
  fi
}
trap cleanup EXIT TERM INT

echo "Starting vLLM server..."
python -m vllm.entrypoints.openai.api_server \
  --model "$MODEL_ID" --served-model-name "$SERVED_NAME" --host 127.0.0.1 --port 8000 \
  --dtype auto --max-model-len 32768 --gpu-memory-utilization 0.90 \
  --max-num-seqs 256 \
  --enable-prefix-caching \
  --enable-auto-tool-choice --tool-call-parser hermes \
  --trust-remote-code --generation-config vllm &
VLLM_PID=$!

for i in $(seq 1 300); do
  if ! kill -0 "$VLLM_PID" 2>/dev/null; then
    wait "$VLLM_PID" || true
    exit 1
  fi
  STATUS="$(python -c "
import json, urllib.request
try:
    data = json.load(urllib.request.urlopen('http://127.0.0.1:8000/v1/models', timeout=2))
    print('ok' if any('Qwen3-8B' in item.get('id', '') for item in data.get('data', [])) else 'wait')
except Exception:
    print('wait')
")"
  if [[ "$STATUS" == "ok" ]]; then
    echo "vLLM ready after ${i} checks"
    break
  fi
  sleep 3
done

echo "Running M7 smoke set..."
python -u scripts/m7_runner.py \
  --config configs/m7.yaml \
  --dataset hotpotqa \
  --questions-file "$QUESTIONS_FILE" \
  --output "$RUN_OUT" \
  --workers 2

echo "Running offline eval..."
python -u scripts/eval_offline.py "$RUN_OUT/predictions.jsonl"

echo "M7 smoke job complete"
