#!/bin/bash
#SBATCH --job-name=s7b_evM
#SBATCH --partition=gpu_h100
#SBATCH --time=01:00:00
#SBATCH --ntasks=1
#SBATCH --cpus-per-task=16
#SBATCH --gpus=1
#SBATCH --mem=96G
#SBATCH --dependency=afterok:20205341
#SBATCH --output=/projects/prjs1800/msc-thesis/02-arag-multi-agent/results/logs/%j_sage_v7b_1000_musique_eval.out

set -euo pipefail
module purge; module load 2025; module load Anaconda3/2025.06-1; module load CUDA/12.8.0

cd /projects/prjs1800/msc-thesis/02-arag-multi-agent
source /projects/prjs1800/venvs/arag-venv/bin/activate
export PYTHONNOUSERSITE=1
export HF_HOME="/projects/prjs1800/.cache/huggingface"
export HF_HUB_CACHE="$HF_HOME"; export TRANSFORMERS_CACHE="$HF_HOME"
export TOKENIZERS_PARALLELISM=false
export ARAG_API_KEY="dummy"
export ARAG_BASE_URL="http://127.0.0.1:8000/v1"
export ARAG_MODEL="Qwen3-30B-A3B"

MODEL_ID="Qwen/Qwen3-30B-A3B"; SERVED_NAME="Qwen3-30B-A3B"
PREDS="results/sage_v7b_1000/musique/predictions.jsonl"

echo "=== SAGE v7b MuSiQue 1000q — Eval ==="
echo "Start: $(date)"

cleanup() { [[ -n "${VLLM_PID:-}" ]] && kill -0 "$VLLM_PID" 2>/dev/null && kill "$VLLM_PID" || true; }
trap cleanup EXIT TERM INT

# Start vLLM
vllm serve "$MODEL_ID" --served-model-name "$SERVED_NAME" --host 127.0.0.1 --port 8000 \
    --dtype auto --max-model-len 32768 --gpu-memory-utilization 0.92 --max-num-seqs 64 \
    --enable-prefix-caching --trust-remote-code --generation-config vllm &
VLLM_PID=$!

for i in $(seq 1 360); do
    if ! kill -0 "$VLLM_PID" 2>/dev/null; then wait "$VLLM_PID" || true; exit 1; fi
    curl -fsS http://127.0.0.1:8000/v1/models 2>/dev/null | grep -q "$SERVED_NAME" && echo "vLLM ready after ~$((i*5))s" && break
    sleep 5
done

# Offline eval
echo ""
echo "=== Offline eval ==="
PYTHONPATH=src python -u scripts/eval_offline.py "$PREDS"

# LLM Judge eval
echo ""
echo "=== LLM Judge eval ==="
PYTHONPATH=src python -u scripts/eval.py --predictions "$PREDS"

# Summary
echo ""
echo "=== RESULTS ==="
echo "E4 MuSiQue: 37.6% (376/1000)"
echo "SAGE v7 original: 36.79% (351/954)"

python3 << 'PYEOF'
import json
preds = [json.loads(l) for l in open("results/sage_v7b_1000/musique/predictions.jsonl")]
correct = sum(1 for p in preds if p.get("llm_accuracy") == 1.0)
answered = sum(1 for p in preds if p["pred_answer"].strip())
total = len(preds)
empty = total - answered
print(f"Total: {total}, Answered: {answered}, Empty: {empty}")
print(f"LLM Correct: {correct}/{answered} = {correct/max(answered,1)*100:.2f}%")
delta = correct/max(answered,1)*100 - 37.6
print(f"vs E4 (37.6%): {'BEATS' if delta > 0 else 'BELOW'} by {abs(delta):.2f}pp")
PYEOF

echo ""
echo "=== Done === $(date)"
