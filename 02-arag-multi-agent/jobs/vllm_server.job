#!/bin/bash
#SBATCH --job-name=vllm-qwen3-30b
#SBATCH --partition=gpu_a100
#SBATCH --time=24:00:00
#SBATCH --ntasks=1
#SBATCH --cpus-per-task=8
#SBATCH --gpus=1
#SBATCH --mem=96G
#SBATCH --output=/projects/prjs1800/msc-thesis/02-arag-multi-agent/results/logs/%j_vllm_server.out

# ==========================================================================
# vLLM Server for Qwen3-30B-A3B
# Launch this FIRST, then submit experiment jobs.
#
# Usage:
#   sbatch jobs/vllm_server.job                    # Standard (prefix caching only)
#   LMCACHE=1 sbatch jobs/vllm_server.job          # With LMCache (for M3)
# ==========================================================================

set -euo pipefail

module purge
module load 2025
module load Anaconda3/2025.06-1
module load CUDA/12.8.0

source /projects/prjs1800/venvs/arag-venv/bin/activate
export PYTHONNOUSERSITE=1

export HF_HOME="/projects/prjs1800/.cache/huggingface"
export HF_HUB_CACHE="$HF_HOME"
export TRANSFORMERS_CACHE="$HF_HOME"
export TOKENIZERS_PARALLELISM=false

MODEL_ID="Qwen/Qwen3-30B-A3B"
SERVED_NAME="Qwen3-30B-A3B"
HOST="127.0.0.1"
PORT="8000"

# Base vLLM arguments
VLLM_ARGS=(
    "$MODEL_ID"
    --served-model-name "$SERVED_NAME"
    --host "$HOST"
    --port "$PORT"
    --dtype auto
    --max-model-len 16384
    --gpu-memory-utilization 0.90
    --max-num-seqs 8
    --enable-prefix-caching
    --enable-auto-tool-choice
    --tool-call-parser hermes
    --trust-remote-code
    --generation-config vllm
)

# Optional LMCache integration (for M3 experiment)
if [ "${LMCACHE:-0}" = "1" ]; then
    echo "Launching vLLM with LMCache enabled..."

    cat > /tmp/lmcache_config.yaml << 'EOF'
chunk_size: 256
local_cpu: true
max_local_cpu_size: 10.0
enable_blending: false
cache_policy: LRU
EOF

    export LMCACHE_CONFIG_FILE=/tmp/lmcache_config.yaml
    VLLM_ARGS+=(--kv-cache-dtype auto)

    echo "LMCache config: chunk_size=256, local_cpu=true, max_cpu=10GB"
else
    echo "Launching vLLM with built-in prefix caching only..."
fi

echo "Model: $MODEL_ID"
echo "Served as: $SERVED_NAME"
echo "Port: $PORT"
echo "Max sequences: 8"
echo "Starting vLLM server..."

vllm serve "${VLLM_ARGS[@]}"
