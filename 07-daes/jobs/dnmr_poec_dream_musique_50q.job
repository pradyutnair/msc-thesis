#!/bin/bash
#SBATCH --job-name=dnmr-poec-mus50
#SBATCH --partition=gpu_h100
#SBATCH --time=03:00:00
#SBATCH --ntasks=1
#SBATCH --cpus-per-task=8
#SBATCH --gpus=1
#SBATCH --mem=96G
#SBATCH --output=/projects/prjs1800/msc-thesis/07-daes/jobs/output/dnmr_poec_dream_musique_50q_%j.log

module load 2025
module load Anaconda3/2025.06-1
cd /projects/prjs1800
module load CUDA/12.8.0

source /projects/prjs1800/venvs/arag-venv/bin/activate
export PYTHONNOUSERSITE=1
export PYTHONPATH=/projects/prjs1800/msc-thesis/07-daes/dllm:/projects/prjs1800/msc-thesis/07-daes/src/daes
export HF_HOME=/projects/prjs1800/.cache/huggingface
export HF_HUB_CACHE=/projects/prjs1800/.cache/huggingface
export TRANSFORMERS_CACHE=/projects/prjs1800/.cache/huggingface
export HF_DATASETS_CACHE=/projects/prjs1800/.cache/huggingface

cd /projects/prjs1800/msc-thesis/07-daes
mkdir -p jobs/output results/dnmr_poec

python -u src/daes/dnmr_poec_pilot.py \
  --model dream \
  --dataset musique \
  --start_idx 0 \
  --n_questions 50 \
  --steps 32 \
  --answer_tokens 32 \
  --n_candidates 3 \
  --initial_top_k 5 \
  --expand_top_k 3 \
  --extraction_steps 12 \
  --top_b_values 5,8,12 \
  --lambda_values 0.3,0.5 \
  --gamma_values 0,0.5 \
  --output results/dnmr_poec/dream_musique_50q_grid.json \
  --log_every 1 \
  --save_every 5
