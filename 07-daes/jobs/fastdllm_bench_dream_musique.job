#!/bin/bash
#SBATCH --job-name=fdllm-bench-dream-mq
#SBATCH --partition=gpu_a100
#SBATCH --gres=gpu:1
#SBATCH --cpus-per-task=4
#SBATCH --mem=80G
#SBATCH --time=01:30:00
#SBATCH --output=/projects/prjs1800/msc-thesis/07-daes/results/fastdllm_benchmark/dream_musique_%j.out

source /projects/prjs1800/venvs/arag-venv/bin/activate
export PYTHONPATH=/projects/prjs1800/msc-thesis/07-daes/dllm:/projects/prjs1800/msc-thesis/07-daes/src/daes:/projects/prjs1800/msc-thesis/07-daes/Fast-dLLM/llada
export HF_HOME=/projects/prjs1800/.cache/huggingface
export TRANSFORMERS_CACHE=/projects/prjs1800/.cache/huggingface
cd /projects/prjs1800/msc-thesis/07-daes
mkdir -p /projects/prjs1800/msc-thesis/07-daes/results/fastdllm_benchmark

python -u src/daes/fastdllm_benchmark.py \
  --model dream \
  --dataset musique \
  --n_questions 20 \
  --output /projects/prjs1800/msc-thesis/07-daes/results/fastdllm_benchmark/dream_musique_20q.json
