#!/bin/bash
#SBATCH --job-name=eamd-w18
#SBATCH --output=/projects/prjs1800/msc-thesis/07-daes/results/eamd_wiki18_full/logs/%x_%A_%a.out
#SBATCH --partition=gpu_h100
#SBATCH --gpus=1
#SBATCH --cpus-per-task=16
#SBATCH --mem=96G
#SBATCH --time=01:30:00

set -euo pipefail

source /projects/prjs1800/venvs/arag-venv/bin/activate
export PYTHONPATH=/projects/prjs1800/msc-thesis/07-daes/dllm:/projects/prjs1800/msc-thesis/07-daes/src/daes:${PYTHONPATH:-}
export HF_HOME=/projects/prjs1800/.cache/huggingface
export TRANSFORMERS_CACHE=/projects/prjs1800/.cache/huggingface
export HF_HUB_OFFLINE=1
export TRANSFORMERS_OFFLINE=1
export TOKENIZERS_PARALLELISM=false
export OMP_NUM_THREADS=${SLURM_CPUS_PER_TASK:-16}
export MKL_NUM_THREADS=${SLURM_CPUS_PER_TASK:-16}

DATASET=${DATASET:?DATASET not set}
SHARD_SIZE=${SHARD_SIZE:-100}
METHODS=${METHODS:-baseline,spread,aram,pool,eamd_regen,eamd_remask}
LOG_EVERY=${LOG_EVERY:-10}
RETR_BATCH=${RETR_BATCH:-128}
ENCODE_BATCH=${ENCODE_BATCH:-64}

START=$((SLURM_ARRAY_TASK_ID * SHARD_SIZE))
END=$((START + SHARD_SIZE))
OUT_DIR=/projects/prjs1800/msc-thesis/07-daes/results/eamd_wiki18_full/${DATASET}/shards
OUT_PATH=${OUT_DIR}/eamd_wiki18_${DATASET}_${START}_${END}.json

mkdir -p "$OUT_DIR"
mkdir -p /projects/prjs1800/msc-thesis/07-daes/results/eamd_wiki18_full/logs

cd /projects/prjs1800/msc-thesis/07-daes
python -u src/daes/eamd_wiki18_full.py \
  --dataset "$DATASET" \
  --start_idx "$START" \
  --end_idx "$END" \
  --methods "$METHODS" \
  --retrieval_batch_size "$RETR_BATCH" \
  --retriever_encode_batch_size "$ENCODE_BATCH" \
  --log_every "$LOG_EVERY" \
  --output "$OUT_PATH"
