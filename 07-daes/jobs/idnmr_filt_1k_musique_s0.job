#!/bin/bash
#SBATCH --job-name=filt-mus-s0
#SBATCH --partition=gpu_a100
#SBATCH --gres=gpu:1
#SBATCH --cpus-per-task=8
#SBATCH --mem=80G
#SBATCH --time=14:00:00
#SBATCH --output=/projects/prjs1800/msc-thesis/07-daes/results/idnmr_filtered/filt_1k_musique_s0_%j.out

source /projects/prjs1800/venvs/arag-venv/bin/activate
export PYTHONPATH=/projects/prjs1800/msc-thesis/07-daes/dllm:/projects/prjs1800/msc-thesis/07-daes/src/daes
export HF_HOME=/projects/prjs1800/.cache/huggingface
export TRANSFORMERS_CACHE=/projects/prjs1800/.cache/huggingface
cd /projects/prjs1800/msc-thesis/07-daes
mkdir -p /projects/prjs1800/msc-thesis/07-daes/results/idnmr_filtered

python -u src/daes/idnmr_filtered.py \
  --model dream --dataset musique \
  --start_idx 0 --n_questions 200 \
  --max_rounds 3 --steps 32 --answer_tokens 32 \
  --n_candidates 3 --initial_top_k 5 --expand_top_k 3 \
  --max_new_per_round 5 \
  --output /projects/prjs1800/msc-thesis/07-daes/results/idnmr_filtered/dream_musique_filt_1k_s0.json
