#!/bin/bash
#SBATCH --job-name=eval-prop
#SBATCH --partition=gpu_h100
#SBATCH --gres=gpu:1
#SBATCH --cpus-per-task=8
#SBATCH --mem=80G
#SBATCH --time=02:00:00
#SBATCH --output=/projects/prjs1800/msc-thesis/07-daes/results/eval_proper_%j.out

source /projects/prjs1800/venvs/arag-venv/bin/activate
export PYTHONPATH=/projects/prjs1800/msc-thesis/07-daes/dllm:$PYTHONPATH
export HF_HOME=/projects/prjs1800/.cache/huggingface
export TRANSFORMERS_CACHE=/projects/prjs1800/.cache/huggingface
cd /projects/prjs1800/msc-thesis/07-daes

echo "=== Base Dream (proven pipeline) ==="
python -u src/daes/eval_sft_proper.py --dataset musique --n_questions 50 --output_dir results

echo ""
echo "=== SFT Dream (answer-only LoRA) ==="
python -u src/daes/eval_sft_proper.py --dataset musique --n_questions 50 \
  --lora_path /projects/prjs1800/msc-thesis/07-daes/models/dream_qa_sft \
  --output_dir results
