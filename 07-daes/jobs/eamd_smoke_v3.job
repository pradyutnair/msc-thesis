#!/bin/bash
#SBATCH --job-name=eamd-smoke3
#SBATCH --output=/projects/prjs1800/msc-thesis/07-daes/results/eamd_smoke_v3_%j.out
#SBATCH --partition=gpu_h100
#SBATCH --gpus=1
#SBATCH --cpus-per-task=8
#SBATCH --mem=80G
#SBATCH --time=00:45:00

source /projects/prjs1800/venvs/arag-venv/bin/activate
export PYTHONPATH=/projects/prjs1800/msc-thesis/07-daes/dllm:/projects/prjs1800/msc-thesis/07-daes/src/daes:$PYTHONPATH
export HF_HOME=/projects/prjs1800/.cache/huggingface
export TRANSFORMERS_CACHE=/projects/prjs1800/.cache/huggingface

cd /projects/prjs1800/msc-thesis/07-daes
python -u src/daes/eamd_smoke_v3.py --dataset musique --start_idx 0 --n_questions 5 --output results/eamd_smoke_v3_5q.json
