#!/bin/bash
#SBATCH --job-name=v2-correct-pilot
#SBATCH --partition=gpu_h100
#SBATCH --gres=gpu:1
#SBATCH --cpus-per-task=8
#SBATCH --mem=80G
#SBATCH --time=01:00:00
#SBATCH --output=/projects/prjs1800/msc-thesis/07-daes/results/eamd_v2_wiki18/logs/%x_%j.out

set -euo pipefail

source /projects/prjs1800/venvs/arag-venv/bin/activate
export PYTHONPATH=/projects/prjs1800/msc-thesis/07-daes/dllm:/projects/prjs1800/msc-thesis/07-daes/src/daes
export HF_HOME=/projects/prjs1800/.cache/huggingface
export TRANSFORMERS_CACHE=/projects/prjs1800/.cache/huggingface

mkdir -p /projects/prjs1800/msc-thesis/07-daes/results/eamd_v2_wiki18/logs
mkdir -p /projects/prjs1800/msc-thesis/07-daes/results/eamd_v2_wiki18/dream/musique

cd /projects/prjs1800/msc-thesis/07-daes

python -u /projects/prjs1800/msc-thesis/07-daes/src/daes/eamd_v2_wiki18.py \
  --model dream \
  --dataset musique \
  --start_idx 0 \
  --n_questions 50 \
  --methods baseline,spread,aram,pool,eamd_v2_regen,eamd_v2_remask \
  --steps 8 \
  --answer_tokens 8 \
  --temperature 0.1 \
  --n_candidates 3 \
  --initial_top_k 5 \
  --expand_top_k 3 \
  --seed_query_mode baseline \
  --gamma_cap 8.0 \
  --tau 0.20 \
  --remask_prior 0.40 \
  --remask_cost 0.0 \
  --remask_threshold 0.15 \
  --output /projects/prjs1800/msc-thesis/07-daes/results/eamd_v2_wiki18/dream/musique/eamd_v2_correct_pilot_50q_8x8.json
