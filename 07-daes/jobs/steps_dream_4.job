#!/bin/bash
#SBATCH --job-name=steps4-dream
#SBATCH --partition=gpu_a100
#SBATCH --gpus=1
#SBATCH --cpus-per-task=4
#SBATCH --mem=96G
#SBATCH --time=00:30:00
#SBATCH --output=/projects/prjs1800/msc-thesis/07-daes/results/steps4_dream_10q_%j.out

module load 2024
source /projects/prjs1800/venvs/arag-venv/bin/activate
cd /projects/prjs1800/msc-thesis/07-daes

python -u src/daes/idnmr_pilot.py \
    --model dream \
    --dataset hotpotqa \
    --n_questions 10 \
    --steps 32 \
    --answer_tokens 32 \
    --extraction_steps 4 \
    --output results/steps4_dream_10q.json \
    --log_every 1 \
    --save_every 5
