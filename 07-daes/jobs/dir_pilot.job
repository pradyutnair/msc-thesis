#!/bin/bash
#SBATCH --job-name=dir-pilot
#SBATCH --partition=gpu_h100
#SBATCH --gres=gpu:1
#SBATCH --cpus-per-task=8
#SBATCH --mem=80G
#SBATCH --time=04:00:00
#SBATCH --output=/projects/prjs1800/msc-thesis/07-daes/results/dir/dir_pilot_%j.out

source /projects/prjs1800/venvs/arag-venv/bin/activate
export PYTHONPATH=/projects/prjs1800/msc-thesis/07-daes/dllm:/projects/prjs1800/msc-thesis/07-daes/src/daes
export HF_HOME=/projects/prjs1800/.cache/huggingface
export TRANSFORMERS_CACHE=/projects/prjs1800/.cache/huggingface
cd /projects/prjs1800/msc-thesis/07-daes
mkdir -p /projects/prjs1800/msc-thesis/07-daes/results/dir

python -u src/daes/eamd_dir.py \
  --model dream --dataset musique \
  --n_questions 50 --steps 32 --answer_tokens 32 \
  --temperature 0.0 --initial_top_k 5 --expand_top_k 3 \
  --bridge_top_k 3 --gamma_mult 0.5 --gamma_cap 8.0 \
  --remask_max_m 4 \
  --output /projects/prjs1800/msc-thesis/07-daes/results/dir/dream_musique_dir_50q.json
