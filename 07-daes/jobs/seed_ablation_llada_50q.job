#!/bin/bash
#SBATCH --job-name=seed-abl-llada
#SBATCH --partition=gpu_a100
#SBATCH --gres=gpu:1
#SBATCH --cpus-per-task=8
#SBATCH --mem=80G
#SBATCH --time=04:00:00
#SBATCH --output=/projects/prjs1800/msc-thesis/07-daes/results/seed_ablation_llada_%j.out

source /projects/prjs1800/venvs/arag-venv/bin/activate
export PYTHONPATH=/projects/prjs1800/msc-thesis/07-daes/dllm:/projects/prjs1800/msc-thesis/07-daes/src/daes
export HF_HOME=/projects/prjs1800/.cache/huggingface
export TRANSFORMERS_CACHE=/projects/prjs1800/.cache/huggingface
cd /projects/prjs1800/msc-thesis/07-daes

# Run the FIXED idnmr_pilot.py (full 32-token seed) on same 50q
python -u src/daes/idnmr_pilot.py \
  --model llada \
  --dataset musique \
  --start_idx 0 \
  --n_questions 50 \
  --steps 32 \
  --answer_tokens 32 \
  --n_candidates 3 \
  --extraction_steps 12 \
  --output results/dnmr_v2_fixed/llada_musique_seed_ablation_50q.json
