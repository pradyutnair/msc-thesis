#!/bin/bash
#SBATCH --job-name=base_ext
#SBATCH --partition=gpu_h100
#SBATCH --gpus=1
#SBATCH --ntasks=1
#SBATCH --cpus-per-task=18
#SBATCH --mem=64G
#SBATCH --time=01:00:00
#SBATCH --output=jobs/output/pool_base_extract_50q_%j.log

source /projects/prjs1800/venvs/arag-venv/bin/activate
export PYTHONPATH=/projects/prjs1800/msc-thesis/07-daes/dllm:/projects/prjs1800/msc-thesis/07-daes/src/daes
export HF_HOME=/projects/prjs1800/.cache/huggingface
export TRANSFORMERS_CACHE=/projects/prjs1800/.cache/huggingface
export DAES_FAISS_GPU=1
export DAES_FAISS_GPU_BACKEND=torch

cd /projects/prjs1800/msc-thesis/07-daes

python -u src/daes/dnmr_pool_base_extract.py     --model llada     --dataset musique     --n_questions 50     --start_idx 0     --steps 32     --answer_tokens 32     --n_candidates 3     --bridge_n_mask 6     --bridge_steps 12     --bridge_n_branch 3     --initial_top_k 5     --expand_top_k 3     --base_model_name GSAI-ML/LLaDA-8B-Base     --output results/pool_base_extract/llada_musique_50q.json     --log_every 5     --save_every 10
