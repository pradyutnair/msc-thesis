#!/bin/bash
#SBATCH --job-name=pilot-remask
#SBATCH --partition=gpu_a100
#SBATCH --gpus=1
#SBATCH --cpus-per-task=4
#SBATCH --mem=96G
#SBATCH --time=01:00:00
#SBATCH --output=/projects/prjs1800/msc-thesis/07-daes/results/pilot_llada_remask_20q_%j.out

module load 2024
source /projects/prjs1800/venvs/arag-venv/bin/activate
cd /projects/prjs1800/msc-thesis/07-daes

python -u src/daes/eamd_wiki18_full_llada.py \
    --model_type llada \
    --dataset hotpotqa \
    --n_questions 20 \
    --steps 32 \
    --answer_tokens 32 \
    --temperature 0.0 \
    --methods baseline,aram,pool,eamd_remask \
    --output results/pilot_llada_remask_20q.json
