#!/bin/bash
#SBATCH --job-name=sp-ml
#SBATCH --partition=gpu_h100
#SBATCH --gres=gpu:1
#SBATCH --cpus-per-task=8
#SBATCH --mem=80G
#SBATCH --time=04:00:00
#SBATCH --output=/projects/prjs1800/msc-thesis/07-daes/results/spread_var_mult_layer_%j.out

source /projects/prjs1800/venvs/arag-venv/bin/activate
export PYTHONPATH=/projects/prjs1800/msc-thesis/07-daes/dllm:$PYTHONPATH
export HF_HOME=/projects/prjs1800/.cache/huggingface
export TRANSFORMERS_CACHE=/projects/prjs1800/.cache/huggingface
cd /projects/prjs1800/msc-thesis/07-daes

# Multiplicative: confidence * (1 + gamma*(rel-0.5))
echo "=== multiplicative gamma=1.0 ==="
python -u src/daes/spread_variants.py \
  --dataset musique --mode multiplicative --gamma 1.0 \
  --n_questions 50 --steps 128 --n_tokens 512 \
  --output_dir results

echo "=== multiplicative gamma=5.0 ==="
python -u src/daes/spread_variants.py \
  --dataset musique --mode multiplicative --gamma 5.0 \
  --n_questions 50 --steps 128 --n_tokens 512 \
  --output_dir results

echo "=== multiplicative gamma=10.0 ==="
python -u src/daes/spread_variants.py \
  --dataset musique --mode multiplicative --gamma 10.0 \
  --n_questions 50 --steps 128 --n_tokens 512 \
  --output_dir results

# Layer 20 (best variance from prior experiments: std=0.034 vs 0.019 at last layer)
echo "=== layer20 gamma=1.0 ==="
python -u src/daes/spread_variants.py \
  --dataset musique --mode layer20 --gamma 1.0 \
  --n_questions 50 --steps 128 --n_tokens 512 \
  --output_dir results

echo "=== layer20 gamma=5.0 ==="
python -u src/daes/spread_variants.py \
  --dataset musique --mode layer20 --gamma 5.0 \
  --n_questions 50 --steps 128 --n_tokens 512 \
  --output_dir results

# Softmax over cosine sims (creates more spread even with low variance)
echo "=== softmax_rel gamma=1.0 ==="
python -u src/daes/spread_variants.py \
  --dataset musique --mode softmax_rel --gamma 1.0 \
  --n_questions 50 --steps 128 --n_tokens 512 \
  --output_dir results
