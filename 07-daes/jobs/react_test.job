#!/bin/bash
#SBATCH --job-name=react-test
#SBATCH --partition=gpu_h100
#SBATCH --gres=gpu:1
#SBATCH --cpus-per-task=8
#SBATCH --mem=80G
#SBATCH --time=02:00:00
#SBATCH --output=/projects/prjs1800/msc-thesis/07-daes/results/react_test_%j.out

source /projects/prjs1800/venvs/arag-venv/bin/activate
export HF_HOME=/projects/prjs1800/.cache/huggingface
export TRANSFORMERS_CACHE=/projects/prjs1800/.cache/huggingface
cd /projects/prjs1800/msc-thesis/07-daes

echo "=== ReAct LLaDA on HotpotQA (5q smoke test) ==="
python -u src/daes/react_dllm.py --model llada --dataset hotpotqa --n_questions 5 --max_turns 4 --steps 64

echo ""
echo "=== ReAct Dream on HotpotQA (5q smoke test) ==="
python -u src/daes/react_dllm.py --model dream --dataset hotpotqa --n_questions 5 --max_turns 4 --steps 64
