#!/bin/bash
#SBATCH --job-name=eval-base
#SBATCH --partition=gpu_h100
#SBATCH --gres=gpu:1
#SBATCH --cpus-per-task=8
#SBATCH --mem=80G
#SBATCH --time=02:00:00
#SBATCH --output=/projects/prjs1800/msc-thesis/07-daes/results/eval_base_dream_reasoning_%j.out

source /projects/prjs1800/venvs/arag-venv/bin/activate
export PYTHONPATH=/projects/prjs1800/msc-thesis/07-daes/dllm:$PYTHONPATH
export HF_HOME=/projects/prjs1800/.cache/huggingface
export TRANSFORMERS_CACHE=/projects/prjs1800/.cache/huggingface
cd /projects/prjs1800/msc-thesis/07-daes

echo "=== Base Dream-7B with reasoning template (no SFT, control) ==="
python -u src/daes/eval_sft_qa.py \
  --dataset musique --n_questions 20 \
  --model_path Dream-org/Dream-v0-Instruct-7B \
  --n_tokens 256 --steps 128 \
  --output_dir results
