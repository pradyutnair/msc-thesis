#!/bin/bash
#SBATCH --job-name=paqcd-dream-50q
#SBATCH --partition=gpu_a100
#SBATCH --gres=gpu:1
#SBATCH --cpus-per-task=8
#SBATCH --mem=80G
#SBATCH --time=04:00:00
#SBATCH --output=/projects/prjs1800/msc-thesis/07-daes/results/paqcd_dream_50q_%j.out

source /projects/prjs1800/venvs/arag-venv/bin/activate
export PYTHONPATH=/projects/prjs1800/msc-thesis/07-daes/dllm:/projects/prjs1800/msc-thesis/07-daes/src/daes
export HF_HOME=/projects/prjs1800/.cache/huggingface
export TRANSFORMERS_CACHE=/projects/prjs1800/.cache/huggingface
cd /projects/prjs1800/msc-thesis/07-daes
mkdir -p results/paqcd

python -u src/daes/paqcd_pilot.py \
    --model dream \
    --dataset musique \
    --n_questions 50 \
    --start_idx 0 \
    --output results/paqcd/dream_musique_50q.json
