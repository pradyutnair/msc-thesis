#!/bin/bash
#SBATCH --job-name=remask-dream-50q
#SBATCH --partition=gpu_a100
#SBATCH --gres=gpu:1
#SBATCH --cpus-per-task=8
#SBATCH --mem=80G
#SBATCH --time=06:00:00
#SBATCH --output=/projects/prjs1800/msc-thesis/07-daes/results/eamd_remask_50q_dream_%j.out

source /projects/prjs1800/venvs/arag-venv/bin/activate
export PYTHONPATH=/projects/prjs1800/msc-thesis/07-daes/dllm:/projects/prjs1800/msc-thesis/07-daes/src/daes
export HF_HOME=/projects/prjs1800/.cache/huggingface
export TRANSFORMERS_CACHE=/projects/prjs1800/.cache/huggingface
cd /projects/prjs1800/msc-thesis/07-daes
mkdir -p results/eamd_remask_50q

python -u src/daes/eamd_v2_wiki18.py \
  --model dream \
  --dataset musique \
  --start_idx 0 \
  --n_questions 50 \
  --methods baseline,aram,pool,eamd_v2_remask \
  --steps 32 \
  --answer_tokens 32 \
  --temperature 0.0 \
  --n_candidates 3 \
  --initial_top_k 5 \
  --expand_top_k 3 \
  --output results/eamd_remask_50q/dream_musique_50q.json
