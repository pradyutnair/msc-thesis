#!/bin/bash
#SBATCH --job-name=ar-mqr-50q-think
#SBATCH --partition=gpu_h100
#SBATCH --gres=gpu:1
#SBATCH --cpus-per-task=8
#SBATCH --mem=80G
#SBATCH --time=02:00:00
#SBATCH --output=/projects/prjs1800/msc-thesis/07-daes/results/ar_mqr/ar_mqr_50q_thinking_%j.out

source /projects/prjs1800/venvs/arag-venv/bin/activate
export PYTHONPATH=/projects/prjs1800/msc-thesis/07-daes/dllm:/projects/prjs1800/msc-thesis/07-daes/src/daes
export HF_HOME=/projects/prjs1800/.cache/huggingface
export TRANSFORMERS_CACHE=/projects/prjs1800/.cache/huggingface
cd /projects/prjs1800/msc-thesis/07-daes
mkdir -p /projects/prjs1800/msc-thesis/07-daes/results/ar_mqr

python -u src/daes/ar_mqr_pilot.py \
  --dataset musique \
  --n_questions 50 \
  --n_candidates 3 \
  --initial_top_k 5 \
  --expand_top_k 3 \
  --seed_tokens 16 \
  --answer_tokens 32 \
  --thinking \
  --output /projects/prjs1800/msc-thesis/07-daes/results/ar_mqr/qwen3_musique_ar_mqr_50q_thinking.json
