#!/bin/bash
#SBATCH --job-name=v2fast
#SBATCH --partition=gpu_h100
#SBATCH --gres=gpu:1
#SBATCH --cpus-per-task=8
#SBATCH --mem=80G
#SBATCH --time=01:00:00
#SBATCH --output=/projects/prjs1800/msc-thesis/07-daes/results/eamd_v2_fast/v2fast_%j.out

source /projects/prjs1800/venvs/arag-venv/bin/activate
export PYTHONPATH=/projects/prjs1800/msc-thesis/07-daes/dllm:/projects/prjs1800/msc-thesis/07-daes/src/daes
export HF_HOME=/projects/prjs1800/.cache/huggingface
export TRANSFORMERS_CACHE=/projects/prjs1800/.cache/huggingface
cd /projects/prjs1800/msc-thesis/07-daes

python -u src/daes/eamd_v2_fast.py   --model dream --dataset musique   --n_questions 50 --steps 128 --answer_tokens 8   --temperature 0.1 --n_candidates 3   --initial_top_k 5 --expand_top_k 3   --gamma_cap 8.0 --lambda_max 1.0 --beta 1.0   --output /projects/prjs1800/msc-thesis/07-daes/results/eamd_v2_fast/dream_musique_128_50q.json
