#!/bin/bash
#SBATCH --job-name=ipool-hotpotqa
#SBATCH --partition=gpu_h100
#SBATCH --gres=gpu:1
#SBATCH --cpus-per-task=8
#SBATCH --mem=80G
#SBATCH --time=24:00:00
#SBATCH --output=/projects/prjs1800/msc-thesis/07-daes/results/ieamd/ipool_1000q_hotpotqa_%j.out

source /projects/prjs1800/venvs/arag-venv/bin/activate
export PYTHONPATH=/projects/prjs1800/msc-thesis/07-daes/dllm:/projects/prjs1800/msc-thesis/07-daes/src/daes
export HF_HOME=/projects/prjs1800/.cache/huggingface
export TRANSFORMERS_CACHE=/projects/prjs1800/.cache/huggingface
cd /projects/prjs1800/msc-thesis/07-daes

python -u src/daes/eamd_iterative.py \
  --model dream --dataset hotpotqa \
  --n_questions 1000 --max_rounds 3 \
  --steps 32 --answer_tokens 32 \
  --temperature 0.0 --n_candidates 3 \
  --initial_top_k 5 --expand_top_k 3 \
  --gamma_mult 0.0 --gamma_cap 8.0 \
  --output /projects/prjs1800/msc-thesis/07-daes/results/ieamd/dream_hotpotqa_ipool_1000q.json
