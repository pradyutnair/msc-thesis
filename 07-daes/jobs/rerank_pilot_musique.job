#!/bin/bash
#SBATCH --job-name=rerank-mq
#SBATCH --partition=gpu_h100
#SBATCH --gres=gpu:1
#SBATCH --cpus-per-task=8
#SBATCH --mem=80G
#SBATCH --time=06:00:00
#SBATCH --output=/projects/prjs1800/msc-thesis/07-daes/results/rerank_pilot_musique_%j.out

source /projects/prjs1800/venvs/arag-venv/bin/activate
export PYTHONPATH=/projects/prjs1800/msc-thesis/07-daes/dllm:$PYTHONPATH
export HF_HOME=/projects/prjs1800/.cache/huggingface
export TRANSFORMERS_CACHE=/projects/prjs1800/.cache/huggingface
cd /projects/prjs1800/msc-thesis/07-daes

echo "=== BASELINE top-5 ==="
python -u src/daes/dllm_rerank.py \
  --dataset musique --mode baseline_5 \
  --n_questions 50 --output_dir results

echo ""
echo "=== RERANK by symmetric KL signal (top-20 → top-5) ==="
python -u src/daes/dllm_rerank.py \
  --dataset musique --mode rerank_signal \
  --n_questions 50 --initial_k 20 --rerank_n 5 \
  --output_dir results

echo ""
echo "=== RERANK by entropy reduction (top-20 → top-5) ==="
python -u src/daes/dllm_rerank.py \
  --dataset musique --mode rerank_entropy \
  --n_questions 50 --initial_k 20 --rerank_n 5 \
  --output_dir results

echo ""
echo "=== RERANK by max signal (top-20 → top-5) ==="
python -u src/daes/dllm_rerank.py \
  --dataset musique --mode rerank_signal_max \
  --n_questions 50 --initial_k 20 --rerank_n 5 \
  --output_dir results

echo ""
echo "=== BASELINE top-20 (upper bound — all passages) ==="
python -u src/daes/dllm_rerank.py \
  --dataset musique --mode baseline_20 \
  --n_questions 50 --output_dir results
