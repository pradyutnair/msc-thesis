#!/bin/bash
#SBATCH --job-name=v4-fast-smk-a100
#SBATCH --partition=gpu_a100
#SBATCH --gres=gpu:1
#SBATCH --cpus-per-task=4
#SBATCH --mem=48G
#SBATCH --time=00:30:00
#SBATCH --output=/projects/prjs1800/msc-thesis/07-daes/results/v4_manual/v4_fast_smoke_a100_%j.out

source /projects/prjs1800/venvs/arag-venv/bin/activate
export PYTHONPATH=/projects/prjs1800/msc-thesis/07-daes/dllm:/projects/prjs1800/msc-thesis/07-daes/src/daes
export HF_HOME=/projects/prjs1800/.cache/huggingface
export TRANSFORMERS_CACHE=/projects/prjs1800/.cache/huggingface
cd /projects/prjs1800/msc-thesis/07-daes
mkdir -p /projects/prjs1800/msc-thesis/07-daes/results/v4_manual

python -u src/daes/eamd_v4_fast.py \
  --model dream --dataset musique \
  --n_questions 5 --max_rounds 4 \
  --steps 32 --answer_tokens 32 \
  --temperature 0.0 --n_candidates 3 \
  --initial_top_k 5 --expand_top_k 3 \
  --kappa 1.0 \
  --output /projects/prjs1800/msc-thesis/07-daes/results/v4_manual/dream_musique_v4_fast_smoke_5q_a100.json
