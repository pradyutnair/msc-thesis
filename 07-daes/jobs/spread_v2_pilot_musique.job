#!/bin/bash
#SBATCH --job-name=spread-pilot-mq
#SBATCH --partition=gpu_h100
#SBATCH --gres=gpu:1
#SBATCH --cpus-per-task=8
#SBATCH --mem=80G
#SBATCH --time=04:00:00
#SBATCH --output=/projects/prjs1800/msc-thesis/07-daes/results/spread_v2_pilot_musique_%j.out

source /projects/prjs1800/venvs/arag-venv/bin/activate
export PYTHONPATH=/projects/prjs1800/msc-thesis/07-daes/dllm:$PYTHONPATH
export HF_HOME=/projects/prjs1800/.cache/huggingface
export TRANSFORMERS_CACHE=/projects/prjs1800/.cache/huggingface

cd /projects/prjs1800/msc-thesis/07-daes

echo "=== BASELINE ==="
python -u src/daes/spread_v2.py \
  --dataset musique --mode baseline \
  --n_questions 50 --steps 128 --n_tokens 512 --temperature 0.1 \
  --output_dir results

echo ""
echo "=== SPREAD v1 (original hidden-state cosine — expected to fail) ==="
python -u src/daes/spread_v2.py \
  --dataset musique --mode spread_v1 \
  --n_questions 50 --steps 128 --n_tokens 512 --temperature 0.1 \
  --output_dir results

echo ""
echo "=== SPREAD v2 (KL-based selection fix) ==="
python -u src/daes/spread_v2.py \
  --dataset musique --mode spread_v2 \
  --n_questions 50 --steps 128 --n_tokens 512 --temperature 0.1 \
  --output_dir results
