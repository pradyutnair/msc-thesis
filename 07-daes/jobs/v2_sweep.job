#!/bin/bash
#SBATCH --job-name=v2-sweep
#SBATCH --partition=gpu_h100
#SBATCH --gres=gpu:1
#SBATCH --cpus-per-task=8
#SBATCH --mem=80G
#SBATCH --time=02:00:00
#SBATCH --output=/projects/prjs1800/msc-thesis/07-daes/results/eamd_v2_sweep/v2sweep_%j.out

source /projects/prjs1800/venvs/arag-venv/bin/activate
export PYTHONPATH=/projects/prjs1800/msc-thesis/07-daes/dllm:/projects/prjs1800/msc-thesis/07-daes/src/daes
export HF_HOME=/projects/prjs1800/.cache/huggingface
export TRANSFORMERS_CACHE=/projects/prjs1800/.cache/huggingface
cd /projects/prjs1800/msc-thesis/07-daes
mkdir -p /projects/prjs1800/msc-thesis/07-daes/results/eamd_v2_sweep

python -u src/daes/eamd_v2_sweep.py   --model dream --dataset musique   --n_questions 50 --steps 32 --answer_tokens 6   --temperature 0.0 --n_candidates 3   --initial_top_k 5 --expand_top_k 3   --gamma_cap 8.0   --output /projects/prjs1800/msc-thesis/07-daes/results/eamd_v2_sweep/dream_musique_sweep_50q.json
