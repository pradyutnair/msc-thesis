#!/bin/bash
#SBATCH --job-name=eamd-w18-llada
#SBATCH --output=/projects/prjs1800/msc-thesis/07-daes/results/eamd_wiki18_full_llada/logs/%x_%A_%a.out
#SBATCH --partition=gpu_h100
#SBATCH --gpus=1
#SBATCH --cpus-per-task=16
#SBATCH --mem=96G
#SBATCH --time=01:30:00

set -euo pipefail

source /projects/prjs1800/venvs/arag-venv/bin/activate
export PYTHONPATH=/projects/prjs1800/msc-thesis/07-daes/dllm:/projects/prjs1800/msc-thesis/07-daes/src/daes:${PYTHONPATH:-}
export HF_HOME=/projects/prjs1800/.cache/huggingface
export TRANSFORMERS_CACHE=/projects/prjs1800/.cache/huggingface
export HF_HUB_OFFLINE=${HF_HUB_OFFLINE:-1}
export TRANSFORMERS_OFFLINE=${TRANSFORMERS_OFFLINE:-1}
export TOKENIZERS_PARALLELISM=false
export OMP_NUM_THREADS=${SLURM_CPUS_PER_TASK:-16}
export MKL_NUM_THREADS=${SLURM_CPUS_PER_TASK:-16}

DATASET=${DATASET:?DATASET not set}
SHARD_SIZE=${SHARD_SIZE:-100}
METHODS=${METHODS:-baseline,spread,aram,pool,eamd_regen,eamd_remask,eamd_hybrid}
LOG_EVERY=${LOG_EVERY:-10}
RETR_BATCH=${RETR_BATCH:-128}
ENCODE_BATCH=${ENCODE_BATCH:-64}
STEPS=${STEPS:-16}
ANSWER_TOKENS=${ANSWER_TOKENS:-16}
TEMPERATURE=${TEMPERATURE:-0.1}
N_CANDIDATES=${N_CANDIDATES:-3}
MODEL_TYPE=${MODEL_TYPE:-llada}
MODEL_NAME=${MODEL_NAME:-GSAI-ML/LLaDA-8B-Instruct}
RUNNER=${RUNNER:-src/daes/eamd_wiki18_full_llada.py}
OUTPUT_ROOT=${OUTPUT_ROOT:-/projects/prjs1800/msc-thesis/07-daes/results/eamd_wiki18_full_llada}
SEED_QUERY_MODE=${SEED_QUERY_MODE:-aram}
REMASK_MODE=${REMASK_MODE:-span}
DELTA=${DELTA:-0.05}
TAU=${TAU:-0.10}
LAMBDA_MAX=${LAMBDA_MAX:-1.0}
BETA=${BETA:-0.5}
NEIGHBOR_RADIUS=${NEIGHBOR_RADIUS:-0}
QUESTION_DELTA=${QUESTION_DELTA:-0.0}
REFINEMENT_ROUNDS=${REFINEMENT_ROUNDS:-1}
HYBRID_GAMMA=${HYBRID_GAMMA:-0.10}
HYBRID_REGEN_GAMMA=${HYBRID_REGEN_GAMMA:-1.0}

START=$((SLURM_ARRAY_TASK_ID * SHARD_SIZE))
END=$((START + SHARD_SIZE))
OUT_DIR=${OUTPUT_ROOT}/${DATASET}/shards
OUT_PATH=${OUT_DIR}/eamd_wiki18_${DATASET}_${START}_${END}.json

mkdir -p "$OUT_DIR"
mkdir -p ${OUTPUT_ROOT}/logs

cd /projects/prjs1800/msc-thesis/07-daes
python -u ${RUNNER} \
  --model_type "$MODEL_TYPE" \
  --model_name "$MODEL_NAME" \
  --dataset "$DATASET" \
  --start_idx "$START" \
  --end_idx "$END" \
  --methods "$METHODS" \
  --steps "$STEPS" \
  --answer_tokens "$ANSWER_TOKENS" \
  --temperature "$TEMPERATURE" \
  --n_candidates "$N_CANDIDATES" \
  --seed_query_mode "$SEED_QUERY_MODE" \
  --remask_mode "$REMASK_MODE" \
  --delta "$DELTA" \
  --tau "$TAU" \
  --lambda_max "$LAMBDA_MAX" \
  --beta "$BETA" \
  --neighbor_radius "$NEIGHBOR_RADIUS" \
  --question_delta "$QUESTION_DELTA" \
  --refinement_rounds "$REFINEMENT_ROUNDS" \
  --hybrid_gamma "$HYBRID_GAMMA" \
  --hybrid_regen_gamma "$HYBRID_REGEN_GAMMA" \
  --retrieval_batch_size "$RETR_BATCH" \
  --retriever_encode_batch_size "$ENCODE_BATCH" \
  --log_every "$LOG_EVERY" \
  --output "$OUT_PATH"
