#!/bin/bash
#SBATCH --job-name=oracle-brg
#SBATCH --partition=gpu_h100
#SBATCH --gres=gpu:1
#SBATCH --cpus-per-task=8
#SBATCH --mem=80G
#SBATCH --time=04:00:00
#SBATCH --output=/projects/prjs1800/msc-thesis/07-daes/results/oracle/oracle_bridge_%j.out

source /projects/prjs1800/venvs/arag-venv/bin/activate
export PYTHONPATH=/projects/prjs1800/msc-thesis/07-daes/dllm:/projects/prjs1800/msc-thesis/07-daes/src/daes
export HF_HOME=/projects/prjs1800/.cache/huggingface
export TRANSFORMERS_CACHE=/projects/prjs1800/.cache/huggingface
cd /projects/prjs1800/msc-thesis/07-daes
mkdir -p /projects/prjs1800/msc-thesis/07-daes/results/oracle

python -u src/daes/oracle_bridge.py \
  --model dream --n_questions 50 \
  --steps 32 --answer_tokens 32 --temperature 0.0 \
  --initial_top_k 5 --expand_top_k 3 \
  --output /projects/prjs1800/msc-thesis/07-daes/results/oracle/dream_musique_oracle_50q.json
