#!/bin/bash
#SBATCH --job-name=dgmqr_smoke
#SBATCH --output=/projects/prjs1800/msc-thesis/07-daes/results/dgmqr_smoke_%j.out
#SBATCH --partition=gpu_h100
#SBATCH --gpus=1
#SBATCH --cpus-per-task=8
#SBATCH --mem=64G
#SBATCH --time=00:30:00

source /projects/prjs1800/venvs/arag-venv/bin/activate
export PYTHONPATH=/projects/prjs1800/msc-thesis/07-daes/dllm:$PYTHONPATH
export HF_HOME=/projects/prjs1800/.cache/huggingface

cd /projects/prjs1800/msc-thesis/07-daes

echo "=== Smoke test: baseline (5q) ==="
python src/daes/dgmqr.py --dataset musique --mode baseline --n_questions 5

echo ""
echo "=== Smoke test: pool (5q) ==="
python src/daes/dgmqr.py --dataset musique --mode pool --n_questions 5

echo ""
echo "=== Smoke test: vote (5q) ==="
python src/daes/dgmqr.py --dataset musique --mode vote --n_questions 5

echo ""
echo "=== Smoke test: pool + few-shot (5q) ==="
python src/daes/dgmqr.py --dataset musique --mode pool --few_shot --n_questions 5

echo "SMOKE TEST COMPLETE"
