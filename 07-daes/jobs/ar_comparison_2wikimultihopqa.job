#!/bin/bash
#SBATCH --job-name=ar_cmp_2wikimultihopqa
#SBATCH --partition=gpu_a100
#SBATCH --gres=gpu:1
#SBATCH --time=06:00:00
#SBATCH --mem=64G
#SBATCH --cpus-per-task=4
#SBATCH --output=/projects/prjs1800/msc-thesis/07-daes/results/ar_comparison_2wikimultihopqa_%j.out

module load 2024
module load Python/3.11.5-GCCcore-13.2.0
source /projects/prjs1800/venvs/arag-venv/bin/activate

export PYTHONPATH=/projects/prjs1800/msc-thesis/07-daes/dllm:/projects/prjs1800/msc-thesis/07-daes/src/daes
export HF_HOME=/projects/prjs1800/.cache/huggingface
export TRANSFORMERS_CACHE=/projects/prjs1800/.cache/huggingface

cd /projects/prjs1800/msc-thesis/07-daes

python -u src/daes/ar_comparison.py \
    --model dream \
    --dataset 2wikimultihopqa \
    --n_questions 1000 \
    --steps 32 \
    --answer_tokens 32 \
    --n_candidates 3 \
    --extraction_steps 12 \
    --output results/ar_comparison/dream_2wikimultihopqa_ar_cmp_1k.json
