#!/bin/bash
#SBATCH --job-name=oracle-brg-llada
#SBATCH --partition=gpu_h100
#SBATCH --gres=gpu:1
#SBATCH --cpus-per-task=8
#SBATCH --mem=80G
#SBATCH --time=01:00:00
#SBATCH --output=/projects/prjs1800/msc-thesis/07-daes/results/oracle/oracle_bridge_llada_10q_%j.out

source /projects/prjs1800/venvs/arag-venv/bin/activate
export PYTHONPATH=/projects/prjs1800/msc-thesis/07-daes/dllm:/projects/prjs1800/msc-thesis/07-daes/src/daes
export HF_HOME=/projects/prjs1800/.cache/huggingface
export TRANSFORMERS_CACHE=/projects/prjs1800/.cache/huggingface
cd /projects/prjs1800/msc-thesis/07-daes
mkdir -p results/oracle

python -u src/daes/oracle_bridge.py \
    --model llada \
    --n_questions 10 \
    --steps 32 \
    --answer_tokens 32 \
    --output results/oracle/llada_musique_oracle_10q.json
