#!/bin/bash
#SBATCH --job-name=rag-baseline-musq
#SBATCH --partition=gpu_h100
#SBATCH --gres=gpu:1
#SBATCH --cpus-per-task=8
#SBATCH --mem=48G
#SBATCH --time=02:00:00
#SBATCH --output=/projects/prjs1800/msc-thesis/07-daes/results/rag_baseline_musique_%j.out

source /projects/prjs1800/venvs/arag-venv/bin/activate
export PYTHONPATH=/projects/prjs1800/msc-thesis/07-daes/dllm:$PYTHONPATH
export HF_HOME=/projects/prjs1800/.cache/huggingface
export TRANSFORMERS_CACHE=/projects/prjs1800/.cache/huggingface

python /projects/prjs1800/msc-thesis/07-daes/src/daes/mvp_rag_espread.py \
    --dataset musique \
    --n_questions 50 \
    --mode baseline \
    --steps 64 \
    --n_tokens 256 \
    --top_k 5 \
    --alpha 0.5
