#!/bin/bash
#SBATCH --job-name=ll-aram
#SBATCH --partition=gpu_h100
#SBATCH --gres=gpu:1
#SBATCH --cpus-per-task=8
#SBATCH --mem=80G
#SBATCH --time=02:00:00
#SBATCH --output=/projects/prjs1800/msc-thesis/07-daes/results/llada_aram_%j.out

source /projects/prjs1800/venvs/arag-venv/bin/activate
export HF_HOME=/projects/prjs1800/.cache/huggingface
export TRANSFORMERS_CACHE=/projects/prjs1800/.cache/huggingface
cd /projects/prjs1800/msc-thesis/07-daes

echo "=== LLaDA BASELINE (few-shot) ==="
python -u src/daes/aram_llada.py --dataset musique --n_questions 20 --mode baseline

echo ""
echo "=== LLaDA ARAM beta=0.1 ==="
python -u src/daes/aram_llada.py --dataset musique --n_questions 20 --mode aram --beta 0.1

echo ""
echo "=== LLaDA ARAM beta=0.5 ==="
python -u src/daes/aram_llada.py --dataset musique --n_questions 20 --mode aram --beta 0.5
