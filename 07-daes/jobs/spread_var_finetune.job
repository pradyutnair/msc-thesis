#!/bin/bash
#SBATCH --job-name=sp-fine
#SBATCH --partition=gpu_h100
#SBATCH --gres=gpu:1
#SBATCH --cpus-per-task=8
#SBATCH --mem=80G
#SBATCH --time=04:00:00
#SBATCH --output=/projects/prjs1800/msc-thesis/07-daes/results/spread_var_finetune_%j.out

source /projects/prjs1800/venvs/arag-venv/bin/activate
export PYTHONPATH=/projects/prjs1800/msc-thesis/07-daes/dllm:$PYTHONPATH
export HF_HOME=/projects/prjs1800/.cache/huggingface
export TRANSFORMERS_CACHE=/projects/prjs1800/.cache/huggingface
cd /projects/prjs1800/msc-thesis/07-daes

# Fine-tune around gamma=0.5 sweet spot (additive raw)
for G in 0.3 0.4 0.6 0.7; do
  echo "=== additive_raw gamma=$G ==="
  python -u src/daes/spread_variants.py \
    --dataset musique --mode additive_raw --gamma $G \
    --n_questions 50 --steps 128 --n_tokens 512 \
    --output_dir results
done

# Layer 20 + additive_raw at sweet spot gammas
for G in 0.3 0.5 0.7; do
  echo "=== layer20 additive gamma=$G ==="
  python -u src/daes/spread_variants.py \
    --dataset musique --mode layer20 --gamma $G \
    --n_questions 50 --steps 128 --n_tokens 512 \
    --output_dir results
done
