#!/bin/bash
#SBATCH --job-name=remask-sweep
#SBATCH --partition=gpu_h100
#SBATCH --gres=gpu:1
#SBATCH --cpus-per-task=8
#SBATCH --mem=80G
#SBATCH --time=02:00:00
#SBATCH --output=/projects/prjs1800/msc-thesis/07-daes/results/eamd_v2_wiki18/logs/%x_%j.out

set -euo pipefail
source /projects/prjs1800/venvs/arag-venv/bin/activate
export PYTHONPATH=/projects/prjs1800/msc-thesis/07-daes/dllm:/projects/prjs1800/msc-thesis/07-daes/src/daes:${PYTHONPATH:-}
export HF_HOME=/projects/prjs1800/.cache/huggingface
export TRANSFORMERS_CACHE=/projects/prjs1800/.cache/huggingface
cd /projects/prjs1800/msc-thesis/07-daes
mkdir -p results/eamd_v2_wiki18/remask_sweep

python -u src/daes/remask_sweep.py \
  --model dream \
  --dataset musique \
  --n_questions 50 \
  --output_dir results/eamd_v2_wiki18/remask_sweep
