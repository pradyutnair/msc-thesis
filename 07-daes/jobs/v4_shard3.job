#!/bin/bash
#SBATCH --job-name=v4-s3
#SBATCH --partition=gpu_h100
#SBATCH --gres=gpu:1
#SBATCH --cpus-per-task=8
#SBATCH --mem=80G
#SBATCH --time=02:00:00
#SBATCH --output=/projects/prjs1800/msc-thesis/07-daes/results/v4/v4_shard3_%j.out

source /projects/prjs1800/venvs/arag-venv/bin/activate
export PYTHONPATH=/projects/prjs1800/msc-thesis/07-daes/dllm:/projects/prjs1800/msc-thesis/07-daes/src/daes
export HF_HOME=/projects/prjs1800/.cache/huggingface
export TRANSFORMERS_CACHE=/projects/prjs1800/.cache/huggingface
cd /projects/prjs1800/msc-thesis/07-daes

python -u src/daes/eamd_v4_shard3.py   --model dream --dataset musique   --n_questions 50 --max_rounds 3   --steps 32 --answer_tokens 32   --temperature 0.0 --n_candidates 3   --initial_top_k 5 --expand_top_k 3   --kappa 1.0   --output /projects/prjs1800/msc-thesis/07-daes/results/v4/dream_musique_v4_shard3_50q.json
