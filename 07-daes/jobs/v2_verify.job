#!/bin/bash
#SBATCH --job-name=v2-verify
#SBATCH --partition=gpu_h100
#SBATCH --gres=gpu:1
#SBATCH --cpus-per-task=8
#SBATCH --mem=80G
#SBATCH --time=06:00:00
#SBATCH --output=/projects/prjs1800/msc-thesis/07-daes/results/eamd_v2_verify/v2verify_%j.out

source /projects/prjs1800/venvs/arag-venv/bin/activate
export PYTHONPATH=/projects/prjs1800/msc-thesis/07-daes/dllm:/projects/prjs1800/msc-thesis/07-daes/src/daes
export HF_HOME=/projects/prjs1800/.cache/huggingface
export TRANSFORMERS_CACHE=/projects/prjs1800/.cache/huggingface
cd /projects/prjs1800/msc-thesis/07-daes
mkdir -p /projects/prjs1800/msc-thesis/07-daes/results/eamd_v2_verify

python -u src/daes/eamd_v2_verify.py \
  --model dream --dataset musique \
  --n_questions 50 --K 8 \
  --steps 32 --answer_tokens 32 \
  --gen_temperature 0.8 \
  --n_candidates 3 --initial_top_k 5 --expand_top_k 3 \
  --output /projects/prjs1800/msc-thesis/07-daes/results/eamd_v2_verify/dream_musique_verify_50q_K8.json
