#!/bin/bash
#SBATCH --job-name=abrd-llada-50q
#SBATCH --partition=gpu_a100
#SBATCH --gres=gpu:1
#SBATCH --cpus-per-task=8
#SBATCH --mem=80G
#SBATCH --time=06:00:00
#SBATCH --output=/projects/prjs1800/msc-thesis/07-daes/results/abrd_llada_50q_%j.out

source /projects/prjs1800/venvs/arag-venv/bin/activate
export PYTHONPATH=/projects/prjs1800/msc-thesis/07-daes/dllm:/projects/prjs1800/msc-thesis/07-daes/src/daes
export HF_HOME=/projects/prjs1800/.cache/huggingface
export TRANSFORMERS_CACHE=/projects/prjs1800/.cache/huggingface
cd /projects/prjs1800/msc-thesis/07-daes
mkdir -p results/abrd

python -u src/daes/abrd_pilot.py \
    --model llada \
    --dataset musique \
    --n_questions 50 \
    --taps_sigma 1.0 \
    --taps_anneal_frac 0.5 \
    --p2_check_frac 0.5 \
    --p2_remask_frac 0.3 \
    --output results/abrd/llada_musique_50q.json
