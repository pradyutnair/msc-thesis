#!/bin/bash
#SBATCH --job-name=llada-bl
#SBATCH --partition=gpu_h100
#SBATCH --gres=gpu:1
#SBATCH --cpus-per-task=8
#SBATCH --mem=80G
#SBATCH --time=02:00:00
#SBATCH --output=/projects/prjs1800/msc-thesis/07-daes/results/llada_baseline_%j.out

source /projects/prjs1800/venvs/arag-venv/bin/activate
export HF_HOME=/projects/prjs1800/.cache/huggingface
export TRANSFORMERS_CACHE=/projects/prjs1800/.cache/huggingface
cd /projects/prjs1800/msc-thesis/07-daes

echo "=== LLaDA-8B Baseline on MuSiQue (20q smoke test) ==="
python -u src/daes/eval_llada.py --dataset musique --n_questions 20 --steps 128 --n_tokens 512
