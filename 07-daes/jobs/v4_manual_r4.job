#!/bin/bash
#SBATCH --job-name=v4-r4-50q
#SBATCH --partition=gpu_h100
#SBATCH --gres=gpu:1
#SBATCH --cpus-per-task=8
#SBATCH --mem=80G
#SBATCH --time=06:00:00
#SBATCH --output=/projects/prjs1800/msc-thesis/07-daes/results/v4_manual/v4_manual_r4_%j.out

source /projects/prjs1800/venvs/arag-venv/bin/activate
export PYTHONPATH=/projects/prjs1800/msc-thesis/07-daes/dllm:/projects/prjs1800/msc-thesis/07-daes/src/daes
export HF_HOME=/projects/prjs1800/.cache/huggingface
export TRANSFORMERS_CACHE=/projects/prjs1800/.cache/huggingface
cd /projects/prjs1800/msc-thesis/07-daes
mkdir -p /projects/prjs1800/msc-thesis/07-daes/results/v4_manual

python -u src/daes/eamd_v4_trajectory.py \
  --model dream --dataset musique \
  --n_questions 50 --max_rounds 4 \
  --steps 32 --answer_tokens 32 \
  --temperature 0.0 --n_candidates 3 \
  --initial_top_k 5 --expand_top_k 3 \
  --kappa 1.0 \
  --output /projects/prjs1800/msc-thesis/07-daes/results/v4_manual/dream_musique_v4_r4_50q.json
