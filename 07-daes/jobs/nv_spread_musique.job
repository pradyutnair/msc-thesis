#!/bin/bash
#SBATCH --job-name=nv-spread
#SBATCH --partition=gpu_h100
#SBATCH --gres=gpu:1
#SBATCH --cpus-per-task=8
#SBATCH --mem=64G
#SBATCH --time=02:00:00
#SBATCH --output=/projects/prjs1800/msc-thesis/07-daes/results/nv_spread_musique_%j.out

source /projects/prjs1800/venvs/arag-venv/bin/activate
export PYTHONPATH=/projects/prjs1800/msc-thesis/07-daes/dllm:$PYTHONPATH
export HF_HOME=/projects/prjs1800/.cache/huggingface
export TRANSFORMERS_CACHE=/projects/prjs1800/.cache/huggingface

python -u /projects/prjs1800/msc-thesis/07-daes/src/daes/spread_reproduce.py \
    --dataset musique \
    --n_questions 50 \
    --mode spread \
    --L 512 \
    --T 128 \
    --top_k 5 \
    --max_chunk_chars 2000 \
    --index_name index_nvembed_v2_musique_full \
    --retriever_model precomputed \
    --precomputed_queries /projects/prjs1800/external/arag/data/musique/index_nvembed_v2_musique_full/query_embeddings.pkl
