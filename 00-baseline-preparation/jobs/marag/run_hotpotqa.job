#!/bin/bash
#SBATCH --job-name=marag_hotpotqa
#SBATCH --partition=gpu_h100
#SBATCH --time=24:00:00
#SBATCH --ntasks=1
#SBATCH --cpus-per-task=16
#SBATCH --gpus=1
#SBATCH --mem=200G
#SBATCH --output=jobs/output/marag/hotpotqa_%j.log

module purge
module load 2023
module load Python/3.11.3-GCCcore-12.3.0
module load CUDA/12.1.1

source /projects/prjs1800/venvs/marag-py311-venv/bin/activate
export PYTHONNOUSERSITE=1
export HF_HOME=/projects/prjs1800/.cache/huggingface
export PYTHONUNBUFFERED=1
export VLLM_BASE_URL=http://localhost:8000/v1

cd /projects/prjs1800/external/MA-RAG
export PYTHONPATH=/projects/prjs1800/external/MA-RAG:$PYTHONPATH

# Clean up failed results (empty plans) before running
echo "=== Cleaning up failed results ==="
RESULTS_DIR="plan_rag_extract_qwen3-8b_hotpotqa"
if [ -d "$RESULTS_DIR" ]; then
    for f in $RESULTS_DIR/*.json; do
        if [ -f "$f" ]; then
            plan_len=$(python3 -c "import json; d=json.load(open('$f')); print(len(d.get('plan', [])))" 2>/dev/null)
            if [ "$plan_len" = "0" ]; then
                echo "Removing failed result: $f"
                rm "$f"
            fi
        fi
    done
fi
echo "Remaining results: $(ls $RESULTS_DIR/*.json 2>/dev/null | wc -l)"

echo "=== Starting vLLM ==="
nvidia-smi --query-gpu=name,memory.total --format=csv

python -m vllm.entrypoints.openai.api_server \
    --model Qwen/Qwen3-8B \
    --download-dir $HF_HOME \
    --port 8000 \
    --dtype bfloat16 \
    --max-model-len 16384 \
    --gpu-memory-utilization 0.95 \
    --max-num-seqs 64 \
    --trust-remote-code > /tmp/vllm.log 2>&1 &

VLLM_PID=$!

echo "Waiting for vLLM (up to 10 min)..."
for i in {1..120}; do
    curl -s http://localhost:8000/v1/models > /dev/null 2>&1 && { echo "Ready after $((i*5))s"; break; }
    [ $i -eq 120 ] && { echo "vLLM failed to start:"; cat /tmp/vllm.log; exit 1; }
    sleep 5
done

python main.py --model qwen3-8b --dataset hotpotqa --exp plan_rag_extract --gpus 0 --start_index 0 --end_index 500

echo "=== Final Results ==="
echo "Total results: $(ls $RESULTS_DIR/*.json 2>/dev/null | wc -l)"
kill $VLLM_PID 2>/dev/null
