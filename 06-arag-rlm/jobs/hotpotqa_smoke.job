#!/bin/bash
#SBATCH --job-name=rlm_hotpot_smoke
#SBATCH --partition=gpu_h100
#SBATCH --time=01:00:00
#SBATCH --ntasks=1
#SBATCH --cpus-per-task=8
#SBATCH --gpus=1
#SBATCH --mem=64G
#SBATCH --output=jobs/output/rlm_hotpot_smoke.log

set -euo pipefail

module load 2025
module load Anaconda3/2025.06-1
module load CUDA/12.8.0

cd /projects/prjs1800/msc-thesis/06-arag-rlm
source /projects/prjs1800/venvs/arag-venv/bin/activate
export PYTHONNOUSERSITE=1

cleanup() {
  if [[ -n "${VLLM_PID:-}" ]]; then
    kill "${VLLM_PID}" || true
  fi
}
trap cleanup EXIT

vllm serve "Qwen/Qwen3-8B"   --served-model-name "Qwen3-8B"   --max-model-len 16384   --gpu-memory-utilization 0.85   --enable-auto-tool-choice   --tool-call-parser hermes   --trust-remote-code   --generation-config vllm   --port 8000 &
VLLM_PID=$!

until curl -sf http://127.0.0.1:8000/v1/models >/dev/null; do
  sleep 2
done

export ARAG_API_KEY="dummy"
export ARAG_BASE_URL="http://127.0.0.1:8000/v1"
export ARAG_MODEL="Qwen3-8B"
export PYTHONPATH="/projects/prjs1800/msc-thesis/06-arag-rlm/src"

python scripts/run.py   --config configs/hotpotqa.yaml   --questions /projects/prjs1800/msc-thesis/02-arag-multi-agent/data/hotpotqa/m7_smoke_10.json   --output /projects/prjs1800/msc-thesis/06-arag-rlm/results/hotpotqa_smoke   --limit 10
