#!/bin/bash
#SBATCH --job-name=frontier-llada
#SBATCH --partition=gpu_h100
#SBATCH --gpus=1
#SBATCH --cpus-per-task=16
#SBATCH --mem=96G
#SBATCH --time=02:00:00
#SBATCH --output=/projects/prjs1800/msc-thesis/benchmarking/results/logs/%x_%A_%a.out

set -euo pipefail

source /projects/prjs1800/venvs/arag-venv/bin/activate
export PYTHONPATH=/projects/prjs1800/msc-thesis-benchmark/07-daes/dllm:/projects/prjs1800/msc-thesis-benchmark/07-daes/src/daes:${PYTHONPATH:-}
export HF_HOME=/projects/prjs1800/.cache/huggingface
export TRANSFORMERS_CACHE=$HF_HOME
export HF_HUB_CACHE=$HF_HOME
export HF_DATASETS_CACHE=$HF_HOME
export HF_HUB_OFFLINE=${HF_HUB_OFFLINE:-1}
export TRANSFORMERS_OFFLINE=${TRANSFORMERS_OFFLINE:-1}
export EAMD_RETRIEVER_DEVICE=${EAMD_RETRIEVER_DEVICE:-cpu}
export TOKENIZERS_PARALLELISM=false
export OMP_NUM_THREADS=${SLURM_CPUS_PER_TASK:-16}
export MKL_NUM_THREADS=${SLURM_CPUS_PER_TASK:-16}

REPO=${REPO:-/projects/prjs1800/msc-thesis-benchmark}
DATASET=${DATASET:?DATASET not set}
OUTPUT_ROOT=${OUTPUT_ROOT:-/projects/prjs1800/msc-thesis/benchmarking/results/frontier_single}
SHARD_SIZE=${SHARD_SIZE:-100}
MODEL_TYPE=${MODEL_TYPE:-llada}
OUTPUT_SUBDIR=${OUTPUT_SUBDIR:-$MODEL_TYPE}
if [[ -z "${MODEL_NAME:-}" ]]; then
  if [[ "$MODEL_TYPE" == "dream" ]]; then
    MODEL_NAME="Dream-org/Dream-v0-Instruct-7B"
  else
    MODEL_NAME="GSAI-ML/LLaDA-8B-Instruct"
  fi
fi
if [[ -z "${METHODS:-}" ]]; then
  if [[ "$MODEL_TYPE" == "dream" ]]; then
    METHODS="baseline,spread,aram,pool,eamd_regen"
  else
    METHODS="baseline,spread,aram,pool,eamd_micro"
  fi
fi
if [[ -z "${N_CANDIDATES:-}" ]]; then
  if [[ "$MODEL_TYPE" == "dream" ]]; then
    N_CANDIDATES=3
  else
    N_CANDIDATES=0
  fi
fi

START=$((SLURM_ARRAY_TASK_ID * SHARD_SIZE))
END=$((START + SHARD_SIZE))
OUT_DIR=${OUTPUT_ROOT}/${DATASET}/${OUTPUT_SUBDIR}/shards/${START}_${END}
mkdir -p "$OUT_DIR"

cd "$REPO"
python benchmarking/write_qid_manifest.py \
  --dataset "$DATASET" \
  --questions "/projects/prjs1800/msc-thesis/01-arag-reproduction/data/questions_wiki18/${DATASET}.json" \
  --start-idx "$START" \
  --end-idx "$END" \
  --output "$OUT_DIR/manifest.json"

python 07-daes/src/daes/eamd_wiki18_benchmark.py \
  --model_type "$MODEL_TYPE" \
  --model_name "$MODEL_NAME" \
  --dataset "$DATASET" \
  --start_idx "$START" \
  --end_idx "$END" \
  --output_dir "$OUT_DIR" \
  --methods "$METHODS" \
  --steps 6 \
  --answer_tokens 6 \
  --temperature 0.05 \
  --initial_top_k 5 \
  --expand_top_k 3 \
  --n_candidates "$N_CANDIDATES" \
  --micro_pivot_ratio 0.333 \
  --micro_top_m 2 \
  --micro_budget_min 1 \
  --micro_kappa 8.0 \
  --micro_tau_q 0.30 \
  --micro_eta 0.5 \
  --micro_phase1_guidance baseline \
  --neighbor_radius 0 \
  --pool_seed_mode baseline \
  --log_every 10
