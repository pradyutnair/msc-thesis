#!/bin/bash
#SBATCH --job-name=aa_smoke
#SBATCH --partition=gpu_a100
#SBATCH --time=00:45:00
#SBATCH --ntasks=1
#SBATCH --cpus-per-task=16
#SBATCH --gpus=1
#SBATCH --mem=96G
#SBATCH --output=/projects/prjs1800/msc-thesis/05-adaptive-agency/jobs/output/%j_smoke_all.log

set -euo pipefail
module purge; module load 2025; module load Anaconda3/2025.06-1; module load CUDA/12.8.0

cd /projects/prjs1800/msc-thesis/05-adaptive-agency
source /projects/prjs1800/venvs/arag-venv/bin/activate
export PYTHONNOUSERSITE=1
export HF_HOME="/projects/prjs1800/.cache/huggingface"
export HF_HUB_CACHE="$HF_HOME"; export TRANSFORMERS_CACHE="$HF_HOME"
export TOKENIZERS_PARALLELISM=false
export ARAG_API_KEY="dummy"
export ARAG_BASE_URL="http://127.0.0.1:8000/v1"
export ARAG_MODEL="Qwen3-8B"

mkdir -p results/smoke_heuristic/hotpotqa \
         results/smoke_structured/hotpotqa \
         results/smoke_agentic/hotpotqa \
         results/smoke_random/hotpotqa \
         trajectories/smoke_hotpotqa \
         jobs/output

cleanup() { [[ -n "${VLLM_PID:-}" ]] && kill -0 "$VLLM_PID" 2>/dev/null && kill "$VLLM_PID" || true; }
trap cleanup EXIT TERM INT

python -m vllm.entrypoints.openai.api_server \
  --model "Qwen/Qwen3-8B" --served-model-name "Qwen3-8B" --host 127.0.0.1 --port 8000 \
  --dtype auto --max-model-len 32768 --gpu-memory-utilization 0.90 \
  --max-num-seqs 256 \
  --enable-auto-tool-choice --tool-call-parser hermes \
  --trust-remote-code --generation-config vllm &
VLLM_PID=$!

for i in $(seq 1 300); do
  if ! kill -0 "$VLLM_PID" 2>/dev/null; then wait "$VLLM_PID" || true; exit 1; fi
  STATUS="$(python - <<'PY'
import json, urllib.request
try:
    d=json.load(urllib.request.urlopen("http://127.0.0.1:8000/v1/models", timeout=2))
    print("ok" if any("Qwen3-8B" in m.get("id","") for m in d.get("data",[])) else "wait")
except Exception:
    print("wait")
PY
)"
  if [[ "$STATUS" == "ok" ]]; then echo "vLLM ready after ${i} checks"; break; fi
  sleep 3
done

echo ""
echo "========== SMOKE 1: Heuristic (10q) =========="
rm -f results/smoke_heuristic/hotpotqa/predictions.jsonl
PYTHONPATH=src python -u scripts/runner.py \
  --config configs/adaptive_agency.yaml \
  --questions data/hotpotqa/questions.json \
  --output results/smoke_heuristic/hotpotqa \
  --limit 10 --concurrent 10
PYTHONPATH=src python -u scripts/eval_offline.py results/smoke_heuristic/hotpotqa/predictions.jsonl
echo "Heuristic smoke: PASS"

echo ""
echo "========== SMOKE 2: Force-mode structured (10q) =========="
rm -f results/smoke_structured/hotpotqa/predictions.jsonl
PYTHONPATH=src python -u scripts/runner.py \
  --config configs/adaptive_agency.yaml \
  --questions data/hotpotqa/questions.json \
  --output results/smoke_structured/hotpotqa \
  --limit 10 --concurrent 10 \
  --force-mode structured
PYTHONPATH=src python -u scripts/eval_offline.py results/smoke_structured/hotpotqa/predictions.jsonl
echo "Force-mode structured smoke: PASS"

echo ""
echo "========== SMOKE 3: Force-mode agentic (10q) =========="
rm -f results/smoke_agentic/hotpotqa/predictions.jsonl
PYTHONPATH=src python -u scripts/runner.py \
  --config configs/adaptive_agency.yaml \
  --questions data/hotpotqa/questions.json \
  --output results/smoke_agentic/hotpotqa \
  --limit 10 --concurrent 10 \
  --force-mode agentic
PYTHONPATH=src python -u scripts/eval_offline.py results/smoke_agentic/hotpotqa/predictions.jsonl
echo "Force-mode agentic smoke: PASS"

echo ""
echo "========== SMOKE 4: Force-mode random (10q) =========="
rm -f results/smoke_random/hotpotqa/predictions.jsonl
PYTHONPATH=src python -u scripts/runner.py \
  --config configs/adaptive_agency.yaml \
  --questions data/hotpotqa/questions.json \
  --output results/smoke_random/hotpotqa \
  --limit 10 --concurrent 10 \
  --force-mode random
PYTHONPATH=src python -u scripts/eval_offline.py results/smoke_random/hotpotqa/predictions.jsonl
echo "Force-mode random smoke: PASS"

echo ""
echo "========== SMOKE 5: Trajectory collection (10q x 2 samples) =========="
rm -f trajectories/smoke_hotpotqa/trajectories.jsonl
PYTHONPATH=src python -u scripts/collect_trajectories.py \
  --config configs/adaptive_agency.yaml \
  --questions data/hotpotqa/questions.json \
  --output trajectories/smoke_hotpotqa \
  --limit 10 --group-size 2 --concurrent 10 \
  --temperature 0.7 --lambda-efficiency 0.1
echo "Trajectory collection smoke: PASS"

echo ""
echo "========== ALL SMOKE TESTS PASSED =========="
echo ""
echo "Summary:"
PYTHONPATH=src python -u scripts/eval_offline.py \
  results/smoke_heuristic/hotpotqa/predictions.jsonl \
  results/smoke_structured/hotpotqa/predictions.jsonl \
  results/smoke_agentic/hotpotqa/predictions.jsonl \
  results/smoke_random/hotpotqa/predictions.jsonl

echo ""
echo "Trajectories collected:"
wc -l trajectories/smoke_hotpotqa/trajectories.jsonl
python3 -c "
import json
with open('trajectories/smoke_hotpotqa/trajectories.jsonl') as f:
    ts = [json.loads(l) for l in f if l.strip()]
rewards = [t['reward'] for t in ts]
ems = [t['em'] for t in ts]
print(f'  Samples: {len(ts)}')
print(f'  Avg reward: {sum(rewards)/len(rewards):.3f}')
print(f'  Avg EM: {sum(ems)/len(ems):.3f}')
print(f'  Decomposition text present: {sum(1 for t in ts if t.get(\"decomposition_text\"))}/{len(ts)}')
"
