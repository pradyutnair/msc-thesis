#!/bin/bash
#SBATCH --job-name=arag_idx
#SBATCH --partition=gpu_a100
#SBATCH --time=12:00:00
#SBATCH --ntasks=1
#SBATCH --cpus-per-task=8
#SBATCH --gpus=1
#SBATCH --mem=96G
#SBATCH --output=jobs/output/arag_idx.log

set -euo pipefail

module purge
module load 2025
module load Anaconda3/2025.06-1
module load CUDA/12.8.0

cd /projects/prjs1800/external/arag
source /projects/prjs1800/venvs/arag-venv/bin/activate
export PYTHONNOUSERSITE=1

uv run python /projects/prjs1800/external/arag/scripts/build_index.py \
  --chunks /projects/prjs1800/external/arag/data/musique/chunks.json \
  --output /projects/prjs1800/external/arag/data/musique/index_e5_base_v2 \
  --model intfloat/e5-base-v2 \
  --device cuda:0

# HotpotQA
uv run python /projects/prjs1800/external/arag/scripts/build_index.py \
  --chunks /projects/prjs1800/external/arag/data/hotpotqa/chunks.json \
  --output /projects/prjs1800/external/arag/data/hotpotqa/index_e5_base_v2 \
  --model intfloat/e5-base-v2 \
  --device cuda:0

# 2wikimultihop
uv run python /projects/prjs1800/external/arag/scripts/build_index.py \
  --chunks /projects/prjs1800/external/arag/data/2wikimultihop/chunks.json \
  --output /projects/prjs1800/external/arag/data/2wikimultihop/index_e5_base_v2 \
  --model intfloat/e5-base-v2 \
  --device cuda:0