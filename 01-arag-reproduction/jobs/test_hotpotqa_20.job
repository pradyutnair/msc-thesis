#!/bin/bash
#SBATCH --job-name=arag_test_20
#SBATCH --partition=gpu_a100
#SBATCH --time=01:00:00
#SBATCH --ntasks=1
#SBATCH --cpus-per-task=8
#SBATCH --gpus=1
#SBATCH --mem=96G
#SBATCH --output=/projects/prjs1800/msc-thesis/01-arag-reproduction/jobs/output/arag_test_20.log

set -euo pipefail

module purge
module load 2025
module load Anaconda3/2025.06-1
module load CUDA/12.8.0

cd /projects/prjs1800/external/arag
source /projects/prjs1800/venvs/arag-venv/bin/activate
export PYTHONNOUSERSITE=1

export HF_HOME="/projects/prjs1800/.cache/huggingface"
export HF_HUB_CACHE="$HF_HOME"
export TRANSFORMERS_CACHE="$HF_HOME"
export HF_DATASETS_CACHE="$HF_HOME"
export TOKENIZERS_PARALLELISM=false

export ARAG_API_KEY="dummy"
export ARAG_BASE_URL="http://127.0.0.1:8000/v1"
export ARAG_MODEL="Qwen3-8B"

MODEL_ID="Qwen/Qwen3-8B"
SERVED_NAME="Qwen3-8B"
HOST="127.0.0.1"
PORT="8000"
RUN_OUT="/projects/prjs1800/msc-thesis/01-arag-reproduction/results/qwen3-8b-vllm/test_hotpotqa_20"

mkdir -p "$RUN_OUT"

# Clean previous test results
rm -f "$RUN_OUT/predictions.jsonl"

cleanup() {
  if [[ -n "${VLLM_PID:-}" ]] && kill -0 "$VLLM_PID" 2>/dev/null; then
    kill "$VLLM_PID" || true
    wait "$VLLM_PID" || true
  fi
}
trap cleanup EXIT TERM INT

echo "Starting vLLM server..."
vllm serve "$MODEL_ID" \
  --served-model-name "$SERVED_NAME" \
  --host "$HOST" \
  --port "$PORT" \
  --dtype auto \
  --max-model-len 16384 \
  --gpu-memory-utilization 0.90 \
  --generation-config vllm \
  --enable-auto-tool-choice \
  --tool-call-parser hermes \
  --trust-remote-code &
VLLM_PID=$!

READY_URL="http://$HOST:$PORT/v1/models"
MAX_RETRIES=360
for i in $(seq 1 "$MAX_RETRIES"); do
  if ! kill -0 "$VLLM_PID" 2>/dev/null; then
    echo "vLLM process exited before readiness."
    wait "$VLLM_PID" || true
    exit 1
  fi
  resp="$(curl -fsS "$READY_URL" 2>/dev/null || true)"
  if [[ -n "$resp" ]] && echo "$resp" | python -c 'import json,sys; d=json.load(sys.stdin); print(any(m.get("id")=="Qwen3-8B" for m in d.get("data",[])))' | grep -q True; then
    echo "vLLM ready!"
    break
  fi
  sleep 5
done

curl -fsS "$READY_URL" >/dev/null

echo "Running ARAG on 20 questions (hotpotqa) with verbose output..."
uv run --active python /projects/prjs1800/external/arag/scripts/batch_runner.py \
  --config "/projects/prjs1800/msc-thesis/01-arag-reproduction/configs/arag_qwen3_vllm_e5_hotpotqa.yaml" \
  --questions "/projects/prjs1800/external/arag/data/hotpotqa/questions.json" \
  --output "$RUN_OUT" \
  --workers 2 \
  --limit 20 \
  --verbose

echo ""
echo "=== Test complete ==="
echo "Predictions written to: $RUN_OUT/predictions.jsonl"

# Quick sanity check
python3 << 'PYEOF'
import json
total = errors = empty = 0
path = "/projects/prjs1800/msc-thesis/01-arag-reproduction/results/qwen3-8b-vllm/test_hotpotqa_20/predictions.jsonl"
with open(path) as f:
    lines = f.readlines()
for line in lines:
    d = json.loads(line)
    total += 1
    if d.get("error"): errors += 1
    if not d.get("trajectory"): empty += 1
print(f"Total: {total}/20, Errors: {errors}, No tool calls: {empty}")
d = json.loads(lines[0])
ans = d["pred_answer"][:300]
print(f"Sample answer: {ans}")
print(f"Sample loops: {d['loops']}, trajectory steps: {len(d['trajectory'])}")
PYEOF
