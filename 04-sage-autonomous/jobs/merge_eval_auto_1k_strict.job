#!/bin/bash
#SBATCH --job-name=merge_strict
#SBATCH --partition=cbuild
#SBATCH --time=00:30:00
#SBATCH --ntasks=1
#SBATCH --cpus-per-task=4
#SBATCH --mem=8G
#SBATCH --output=/projects/prjs1800/msc-thesis/04-sage-autonomous/jobs/output/%j_merge_eval_auto_1k_strict.log

set -euo pipefail
module purge; module load 2025; module load Anaconda3/2025.06-1

cd /projects/prjs1800/msc-thesis/04-sage-autonomous
source /projects/prjs1800/venvs/arag-venv/bin/activate
export PYTHONNOUSERSITE=1

bash scripts/merge_and_eval_strict.sh
