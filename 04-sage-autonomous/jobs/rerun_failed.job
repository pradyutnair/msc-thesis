#!/bin/bash
#SBATCH --job-name=fix_all
#SBATCH --partition=gpu_a100
#SBATCH --time=01:00:00
#SBATCH --ntasks=1
#SBATCH --cpus-per-task=16
#SBATCH --gpus=1
#SBATCH --mem=96G
#SBATCH --output=/projects/prjs1800/msc-thesis/04-sage-autonomous/jobs/output/%j_rerun_failed.log

set -euo pipefail
module purge; module load 2025; module load Anaconda3/2025.06-1; module load CUDA/12.8.0

cd /projects/prjs1800/msc-thesis/04-sage-autonomous
source /projects/prjs1800/venvs/arag-venv/bin/activate
export PYTHONNOUSERSITE=1
export HF_HOME="/projects/prjs1800/.cache/huggingface"
export HF_HUB_CACHE="$HF_HOME"; export TRANSFORMERS_CACHE="$HF_HOME"
export TOKENIZERS_PARALLELISM=false
export ARAG_API_KEY="dummy"
export ARAG_BASE_URL="http://127.0.0.1:8000/v1"
export ARAG_MODEL="Qwen3-8B"

MODEL_ID="Qwen/Qwen3-8B"
SERVED_NAME="Qwen3-8B"

pkill -f "vllm.entrypoints.openai.api_server" 2>/dev/null || true
sleep 5

cleanup() { [[ -n "${VLLM_PID:-}" ]] && kill -0 "$VLLM_PID" 2>/dev/null && kill "$VLLM_PID" || true; }
trap cleanup EXIT TERM INT

python -m vllm.entrypoints.openai.api_server \
  --model "$MODEL_ID" --served-model-name "$SERVED_NAME" --host 127.0.0.1 --port 8000 \
  --dtype auto --max-model-len 32768 --gpu-memory-utilization 0.90 \
  --max-num-seqs 256 \
  --enable-auto-tool-choice --tool-call-parser hermes \
  --trust-remote-code --generation-config vllm &
VLLM_PID=$!

sleep 30
echo "Waiting for vLLM (PID=$VLLM_PID)..."
for i in $(seq 1 300); do
  if ! kill -0 "$VLLM_PID" 2>/dev/null; then echo "vLLM died"; wait "$VLLM_PID" || true; exit 1; fi
  STATUS="$(python - <<PY
import json, urllib.request
try:
    req = urllib.request.Request(
        "http://127.0.0.1:8000/v1/chat/completions",
        data=json.dumps({
            "model": "Qwen3-8B",
            "messages": [{"role": "user", "content": "Say ok"}],
            "max_tokens": 8
        }).encode(),
        headers={"Content-Type": "application/json"},
        method="POST"
    )
    resp = json.load(urllib.request.urlopen(req, timeout=60))
    if resp.get("choices"):
        print("ok")
    else:
        print("wait")
except Exception as e:
    print("wait")
PY
)"
  echo "Check $i: $STATUS"
  if [[ "$STATUS" == "ok" ]]; then echo "vLLM ready!"; break; fi
  sleep 5
done

# Rerun failed questions for each dataset
# The runner appends to predictions.jsonl, and we already removed failed entries

echo "=== Rerunning HotpotQA (4 questions) ==="
PYTHONPATH=src python -u scripts/multi_agent_runner.py \
  --config configs/autonomous.yaml \
  --questions data/hotpotqa/rerun_failed.json \
  --output results/auto_1k_final/hotpotqa \
  --concurrent 4
echo "HotpotQA done: $(wc -l < results/auto_1k_final/hotpotqa/predictions.jsonl) predictions"

echo "=== Rerunning 2WikiMultiHop (5 questions) ==="
PYTHONPATH=src python -u scripts/multi_agent_runner.py \
  --config configs/autonomous_2wiki.yaml \
  --questions data/2wikimultihop/rerun_failed.json \
  --output results/auto_1k_final/2wikimultihop \
  --concurrent 5
echo "2Wiki done: $(wc -l < results/auto_1k_final/2wikimultihop/predictions.jsonl) predictions"

echo "=== Rerunning MuSiQue (19 questions) ==="
PYTHONPATH=src python -u scripts/multi_agent_runner.py \
  --config configs/autonomous_musique.yaml \
  --questions data/musique/rerun_failed.json \
  --output results/auto_1k_final/musique \
  --concurrent 10
echo "MuSiQue done: $(wc -l < results/auto_1k_final/musique/predictions.jsonl) predictions"

echo ""
echo "=== Running offline eval on all datasets ==="
PYTHONPATH=src python -u scripts/eval_offline.py \
  results/auto_1k_final/hotpotqa/predictions.jsonl \
  results/auto_1k_final/2wikimultihop/predictions.jsonl \
  results/auto_1k_final/musique/predictions.jsonl

echo ""
echo "=== Comparison with v3r2 baseline ==="
PYTHONPATH=src python -u scripts/eval_offline.py \
  results/auto_1k_final/hotpotqa/predictions.jsonl \
  results/auto_1k_final/2wikimultihop/predictions.jsonl \
  results/auto_1k_final/musique/predictions.jsonl \
  results/sage_v3r2_1000/hotpotqa/predictions.jsonl \
  results/sage_v3r2_1000/2wikimultihop/predictions.jsonl \
  results/sage_v3r2_1000/musique/predictions.jsonl

echo "=== ALL DONE ==="
