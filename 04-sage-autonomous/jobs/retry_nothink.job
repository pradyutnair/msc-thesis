#!/bin/bash
#SBATCH --job-name=sage_retry
#SBATCH --partition=gpu_h100
#SBATCH --time=01:00:00
#SBATCH --gpus=1 --cpus-per-task=16 --mem=96G
#SBATCH --output=/projects/prjs1800/msc-thesis/04-sage-autonomous/jobs/output/%j_retry_nothink_%a.log
#SBATCH --array=0-2
set -euo pipefail
module purge; module load 2025; module load Anaconda3/2025.06-1; module load CUDA/12.8.0
cd /projects/prjs1800/msc-thesis/04-sage-autonomous
source /projects/prjs1800/venvs/arag-venv/bin/activate
export PYTHONNOUSERSITE=1 HF_HOME=/projects/prjs1800/.cache/huggingface ARAG_API_KEY=dummy ARAG_MODEL=Qwen3-8B
DATASETS=(hotpotqa 2wikimultihop musique)
DS=${DATASETS[$SLURM_ARRAY_TASK_ID]}
PORT=$((8000 + SLURM_ARRAY_TASK_ID * 100 + RANDOM % 100))
export ARAG_BASE_URL="http://127.0.0.1:$PORT/v1"
RUN_OUT="results/auto_1k_strict_nothink/${DS}/retry"
mkdir -p "$RUN_OUT"
python -m vllm.entrypoints.openai.api_server --model Qwen/Qwen3-8B --served-model-name Qwen3-8B --host 127.0.0.1 --port $PORT --dtype auto --max-model-len 32768 --gpu-memory-utilization 0.90 --max-num-seqs 256 --enable-prefix-caching --enable-auto-tool-choice --tool-call-parser hermes --chat-template /projects/prjs1800/scripts/qwen3_no_think_template.jinja --trust-remote-code &
VLLM_PID=$!; trap "kill $VLLM_PID 2>/dev/null||true" EXIT
for i in $(seq 1 120); do curl -s http://127.0.0.1:$PORT/v1/models >/dev/null 2>&1 && break; sleep 3; done
PYTHONPATH=src python -u scripts/multi_agent_runner.py --config configs/autonomous_nothink.yaml --questions "data/$DS/retry_questions.json" --output "$RUN_OUT" --concurrent 50
echo "=== SAGE retry $DS DONE ==="
