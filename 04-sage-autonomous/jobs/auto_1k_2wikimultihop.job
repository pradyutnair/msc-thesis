#!/bin/bash
#SBATCH --job-name=a1k_2w
#SBATCH --partition=gpu_a100
#SBATCH --time=02:00:00
#SBATCH --ntasks=1
#SBATCH --cpus-per-task=16
#SBATCH --gpus=1
#SBATCH --mem=96G
#SBATCH --array=0-4
#SBATCH --output=/projects/prjs1800/msc-thesis/04-sage-autonomous/jobs/output/%A_%a_auto_1k_2wikimultihop.log

set -euo pipefail
module purge; module load 2025; module load Anaconda3/2025.06-1; module load CUDA/12.8.0

cd /projects/prjs1800/msc-thesis/04-sage-autonomous
source /projects/prjs1800/venvs/arag-venv/bin/activate
export PYTHONNOUSERSITE=1
export HF_HOME="/projects/prjs1800/.cache/huggingface"
export HF_HUB_CACHE="$HF_HOME"; export TRANSFORMERS_CACHE="$HF_HOME"
export TOKENIZERS_PARALLELISM=false
export ARAG_API_KEY="dummy"
export ARAG_MODEL="Qwen3-8B"

MODEL_ID="Qwen/Qwen3-8B"
SERVED_NAME="Qwen3-8B"
DATASET="2wikimultihop"
CONFIG="configs/autonomous_2wiki.yaml"
SHARD_ID=${SLURM_ARRAY_TASK_ID}
PORT=$((8000 + SLURM_ARRAY_TASK_ID + (SLURM_ARRAY_JOB_ID % 100) * 5))
export ARAG_BASE_URL="http://127.0.0.1:${PORT}/v1"

RUN_OUT="results/auto_1k_final/${DATASET}/shard_${SHARD_ID}"
rm -rf "$RUN_OUT"
mkdir -p "$RUN_OUT" jobs/output

fuser -k ${PORT}/tcp 2>/dev/null || true
sleep 3

cleanup() { [[ -n "${VLLM_PID:-}" ]] && kill -0 "$VLLM_PID" 2>/dev/null && kill "$VLLM_PID" || true; }
trap cleanup EXIT TERM INT

python -m vllm.entrypoints.openai.api_server \
  --model "$MODEL_ID" --served-model-name "$SERVED_NAME" --host 127.0.0.1 --port "$PORT" \
  --dtype auto --max-model-len 32768 --gpu-memory-utilization 0.90 \
  --max-num-seqs 256 \
  --enable-auto-tool-choice --tool-call-parser hermes \
  --trust-remote-code --generation-config vllm &
VLLM_PID=$!

sleep 30
echo "Waiting for vLLM on port $PORT (PID=$VLLM_PID)..."
for i in $(seq 1 300); do
  if ! kill -0 "$VLLM_PID" 2>/dev/null; then echo "vLLM died"; wait "$VLLM_PID" || true; exit 1; fi
  STATUS="$(python - <<PY
import json, urllib.request
try:
    req = urllib.request.Request(
        "http://127.0.0.1:${PORT}/v1/chat/completions",
        data=json.dumps({
            "model": "Qwen3-8B",
            "messages": [{"role": "user", "content": "Say ok"}],
            "max_tokens": 8
        }).encode(),
        headers={"Content-Type": "application/json"},
        method="POST"
    )
    resp = json.load(urllib.request.urlopen(req, timeout=60))
    if resp.get("choices"):
        print("ok")
    else:
        print("wait")
except Exception as e:
    print("wait")
PY
)"
  echo "Check $i: $STATUS"
  if [[ "$STATUS" == "ok" ]]; then echo "vLLM ready!"; break; fi
  sleep 5
done

PYTHONPATH=src python -u scripts/multi_agent_runner.py \
  --config "$CONFIG" \
  --questions "data/$DATASET/shards/questions_shard_${SHARD_ID}.json" \
  --output "$RUN_OUT" \
  --concurrent 100

echo "Shard $SHARD_ID complete: $(wc -l < "$RUN_OUT/predictions.jsonl") predictions"
