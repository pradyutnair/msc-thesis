#!/bin/bash
#SBATCH --job-name=rerank_hotpotqa
#SBATCH --partition=gpu_a100
#SBATCH --gres=gpu:1
#SBATCH --time=04:00:00
#SBATCH --mem=128G
#SBATCH --cpus-per-task=16
#SBATCH --output=/projects/prjs1800/results/logs/%j_reranker_rag_hotpotqa.out
#SBATCH --error=/projects/prjs1800/results/logs/%j_reranker_rag_hotpotqa.err

source /projects/prjs1800/venvs/FlashRAG-venv/bin/activate

export HF_HOME=/projects/prjs1800/.cache/huggingface
export TRANSFORMERS_CACHE=$HF_HOME
export TOKENIZERS_PARALLELISM=false
export OMP_NUM_THREADS=16
export MKL_NUM_THREADS=16
export FAISS_NUM_THREADS=16

# Force MKL as BLAS backend
export LD_PRELOAD=/projects/prjs1800/venvs/FlashRAG-venv/lib/libmkl_rt.so.2
export MKL_THREADING_LAYER=GNU

cd /projects/prjs1800/external/FlashRAG

echo "=== Job started at $(date) ==="
echo "Node: $(hostname), GPU: $(nvidia-smi --query-gpu=name --format=csv,noheader)"
echo "Running Standard RAG + Reranker on HotpotQA"

python -u /projects/prjs1800/msc-thesis/scripts/day2/run_reranker_rag.py \
    --config /projects/prjs1800/msc-thesis/configs/day2/reranker_rag_qwen25_hotpotqa.yaml

echo "=== Job finished at $(date) ==="
