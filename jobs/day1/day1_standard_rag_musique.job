#!/bin/bash
#SBATCH --job-name=std_rag_musique
#SBATCH --partition=gpu_a100
#SBATCH --gres=gpu:1
#SBATCH --time=02:00:00
#SBATCH --mem=128G
#SBATCH --cpus-per-task=16
#SBATCH --output=/projects/prjs1800/results/logs/%j_standard_rag_musique.out
#SBATCH --error=/projects/prjs1800/results/logs/%j_standard_rag_musique.err

source /projects/prjs1800/venvs/FlashRAG-venv/bin/activate

export HF_HOME=/projects/prjs1800/.cache/huggingface
export TRANSFORMERS_CACHE=$HF_HOME
export TOKENIZERS_PARALLELISM=false
export OMP_NUM_THREADS=16
export MKL_NUM_THREADS=16
export FAISS_NUM_THREADS=16

# Force MKL as BLAS backend (replaces crippled OpenBLAS MAX_THREADS=2)
export LD_PRELOAD=/projects/prjs1800/venvs/FlashRAG-venv/lib/libmkl_rt.so.2
export MKL_THREADING_LAYER=GNU

cd /projects/prjs1800/external/FlashRAG

echo "=== Job started at $(date) ==="
echo "Node: $(hostname), GPU: $(nvidia-smi --query-gpu=name --format=csv,noheader)"
echo "OMP_NUM_THREADS=$OMP_NUM_THREADS, MKL_NUM_THREADS=$MKL_NUM_THREADS"
echo "Running Standard RAG on MuSiQue with Qwen2.5-7B-Instruct"

python -u /projects/prjs1800/msc-thesis/scripts/run_standard_rag.py \
    --config /projects/prjs1800/msc-thesis/configs/flashrag/standard_rag_qwen25_musique.yaml

echo "=== Job finished at $(date) ==="
