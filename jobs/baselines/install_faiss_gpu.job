#!/bin/bash
#SBATCH --job-name=install_faiss
#SBATCH --output=jobs/output/baselines/install_faiss_%j.log
#SBATCH --partition=gpu_a100
#SBATCH --gpus=1
#SBATCH --time=00:30:00
#SBATCH --ntasks=1
#SBATCH --cpus-per-task=4
#SBATCH --mem=16G

module purge
module load 2024
module load Miniconda3/23.5.2-0
module load CUDA/12.8.0
module load cuDNN/9.5.0.50-CUDA-12.6.0

source activate /projects/prjs1800/conda_envs/multi_agentic_rag

echo "Installing faiss-gpu..."
pip install faiss-gpu --no-cache-dir

echo "Verifying installation..."
python -c "import faiss; print(f'FAISS version: {faiss.__version__}'); print('FAISS GPU available:', faiss.get_num_gpus() > 0)"
